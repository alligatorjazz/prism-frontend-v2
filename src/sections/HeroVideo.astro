---
import type { HTMLAttributes } from "astro/types";
import LongFlag from "../components/LongFlag.astro";

interface Props extends HTMLAttributes<"section"> {}

const { ...props } = Astro.props;
---

<section {...props}>
  <video src="/video/Websitevideov3.webm" muted autoplay loop> </video>
  <div class="content">
    <h1 class="tagline">For every color,<br />For everyone</h1>
  </div>
</section>

<style>
  section {
    position: relative;
    width: 100%;
    height: calc(100vh - 10rem);
    video {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(75%);
    }

    .content {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      display: flex;
      align-items: center;

      padding: 4rem;
      .tagline {
        font-family: var(--header-font);
        font-size: 6rem;
        line-height: 8rem;
        background-image: repeating-linear-gradient(
          to right,
          red,
          orange,
          yellow,
          green,
          dodgerblue,
          violet,
          white,
          red
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        text-fill-color: transparent;
        background-size: 400% 100%;
        background-repeat: repeat-x;
        animation: HeroText 10s linear infinite;
        filter: drop-shadow(5px 5px 0px black);
      }
    }
  }

  @keyframes HeroText {
    0% {
      background-position: 0% 50%;
    }

    100% {
      background-position: 400% 50%;
    }
  }
</style>
