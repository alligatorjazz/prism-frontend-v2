---
import type { HTMLAttributes } from "astro/types";
import { strictSlug } from "../lib";
import { type SectionProps } from "../types/sections";
import ConstrainedSection from "./ConstrainedSection.astro";

// TODO: implement rich text here
interface Props extends HTMLAttributes<"section"> {
  title: string;
  description: string;
  image?: HTMLAttributes<"img">;
  pointBackTo?: {
    href: string;
    label: string;
  };
}
const { title, description, image, pointBackTo, ...props } = Astro.props;
---

<ConstrainedSection id={strictSlug(title)} {...props}>
  <div class="container">
    <div class="text">
      {
        pointBackTo && (
          <a class="point-back-to" href={pointBackTo.href} type="button">
            {`< Return to ${pointBackTo.label}`}
          </a>
        )
      }

      <h1>{title}</h1>

      {description.split("\n").map((line) => <p>{line}</p>)}
    </div>
    {
      image && (
        <div class="image">
          <img {...image} />
        </div>
      )
    }
  </div>
</ConstrainedSection>

<style lang="scss">
  @use "../styles/utils" as *;
  .container {
    max-width: var(--xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 3rem 1rem;
    color: var(--fg-color);

    .text {
      flex: 1;
      text-align: left;

      .point-back-to {
        font-size: 1.25rem;
        font-weight: 500;
        font-family: var(--header-font);
        text-decoration: none;

        &:visited {
          color: inherit;
        }
      }

      h1 {
        padding-top: 0;
        padding-bottom: 1rem;
        font-size: 2.5rem;
        border-bottom: 2px solid var(--fg-color);
      }
      p {
        margin: 0;
        font-size: 1.5rem;
      }
    }

    .image {
      width: 100%;
      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }
  }

  @include breakpoint-up(md) {
    .container {
      flex-direction: row;
      .image {
        width: 25%;
      }
    }
  }
</style>
