---
import { strictSlug } from "../lib";
import StickerWithTitle, {
  type StickerProps,
} from "@components/StickerWithTitle.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  title: string;
  stickers: StickerProps[];
}

const { title, stickers, ...props } = Astro.props;
---

<section id={strictSlug(title)} {...props}>
  <div class="stickers">
    {stickers.map((sticker) => <StickerWithTitle {...sticker} />)}
  </div>
</section>

<style>
  section {
    background-size: 2000px;
    padding: 4rem 2rem;

    .stickers {
      list-style: none;

      margin-left: 0;
      margin: auto;
      max-width: var(--xl);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-evenly;
      gap: 3rem;
      align-items: center;
    }
  }
</style>
