---
// src/sections/TrackIntro.astro
//
// The "who leads this, and what it does" intro shared by the core-track pages
// and the leadership-program pages. The lead's portrait and title sit in one
// column; the overview copy sits in the other. The row is a wrapping flexbox,
// so it stacks on its own once the viewport can no longer hold both columns —
// there is no separate mobile layout to keep in sync.
//
// Everything is prop-driven rather than slotted, which keeps all of the styling
// inside this file: Astro scoped styles do not cross a component boundary, so
// anything a page slotted in would have to be styled by the page instead.

import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import Polaroid from "@components/Polaroid.astro";

interface Activity {
  title: string;
  description: string;
}

interface Props extends HTMLAttributes<"section"> {
  /** Heading over the overview column. */
  heading?: string;
  /** Small label above the portrait, e.g. "Track Lead" or "Program Lead". */
  eyebrow?: string;
  /** The lead's name. Doubles as the Polaroid caption. */
  name: string;
  /** The lead's role, e.g. "Organizing Director". */
  title: string;
  // TODO: make link open up specific staff page
  link?: string;
  image: ImageMetadata;
  imageAlt?: string;
  /** Overview copy. Newlines become separate paragraphs, as in PageIntro. */
  description: string;
  /** Optional list of what the track actually does, one entry per activity. */
  activities?: Activity[];
}

const {
  heading = "What We Do",
  eyebrow = "Track Lead",
  name,
  title,
  image,
  imageAlt = `Portrait of ${name}`,
  description,
  link,
  activities,
  class: className,
  ...props
} = Astro.props;
---

<section class:list={["track-intro", className]} {...props}>
  <div class="content">
    <a href={"/our-team#staff"} class="lead">
      <p class="eyebrow">{eyebrow}</p>
      <Polaroid
        class="portrait"
        image={{
          src: image,
          alt: imageAlt,
          format: "webp",
          width: 300,
          height: 300,
        }}
        label={name}
      />
      <p class="lead-title">{title}</p>
    </a>

    <div class="overview">
      <h3>{heading}</h3>
      {description.split("\n").map((line) => <p>{line}</p>)}

      {
        activities && activities.length > 0 && (
          <ul class="activities">
            {activities.map((activity) => (
              <li>
                <strong>{activity.title}</strong>
                <span>{activity.description}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/utils" as *;

  .content {
    max-width: var(--xl);
    margin: auto;
    padding: 4rem 1rem;

    /* Side by side while both columns fit; wrapped the moment they do not. */
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem 3rem;
  }

  .lead {
    /* Narrow column — only as wide as the portrait needs, and the first to
       give up space when the row runs out. */
    flex: 0 1 14rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: auto;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    .portrait {
      transition: all 300ms;
    }
    &:hover {
      .portrait {
        transform: rotate(3deg);
        filter: brightness(125%);
      }
    }
  }

  .eyebrow {
    margin: 0;
    font-family: var(--header-font);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .portrait {
    width: 100%;
    max-width: 14rem;
  }

  .lead-title {
    margin: 0;
    font-family: var(--header-font);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .overview {
    /* Fills whatever the lead column leaves. Its 22rem minimum is what pushes
       the row to wrap on narrow screens. */
    flex: 1 1 22rem;
    min-width: 0;

    h3 {
      margin: 0 0 1rem;
      font-size: 1.75rem;
    }

    p {
      margin: 0 0 1rem;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  .activities {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;

    li {
      padding: 1rem;
      background-color: var(--youth-yellow-2);
      filter: var(--shadow-light);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    strong {
      font-family: var(--header-font);
      font-size: 1.15rem;
    }
  }
</style>
