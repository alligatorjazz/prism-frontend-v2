---
// src/sections/FitComparison.astro
//
// "What's the best fit for me?" - Volunteer vs Member, plus the connector
// that carries the eye from Member down into the leadership programs.
//
// This section is the containment context the FlowArrows query, which is why
// container-type: inline-size sits on the root. Removing it silently stops
// the arrows from reorienting.

import FlowArrow from "@components/FlowArrow.astro";
import TornPaperBox from "@components/TornPaperBox.astro";
const tiers = [
  {
    key: "volunteer",
    heading: "Volunteer",
    lead: "For people getting started with activism.",
    body: "Perfect for the eager advocate looking to drop in, get trained on-site, and enjoy a day in community. Volunteers only commit the time they sign up for - usually 2-4 hour shifts. ",
  },
  {
    key: "member",
    heading: "Member",
    lead: "For people that want to go deeper.",
    body: "Designed for the dedicated organizer looking to develop their leadership skills, learn organizing strategies, and become a catalyst for change. Members are committed to a flexible 4- to 8-hour monthly schedule and responsive communication. ",
  },
];
---

<section class="fit-comparison">
  <h2>What's the Best Fit for Me?</h2>

  <div class="tiers">
    {
      tiers.map((tier, index) => (
        <>
          {index > 0 && (
            <FlowArrow
              class="tier-arrow side-arrow"
              angleWide="0deg"
              angleStacked="70deg"
              size={"8rem"}
            />
          )}
          <TornPaperBox>
            <article class:list={["tier ruled-bg", tier.key]}>
              <h3>{tier.heading}</h3>
              <p class="lead">{tier.lead}</p>
              <p>{tier.body}</p>
            </article>
          </TornPaperBox>
        </>
      ))
    }
  </div>

  <div class="descent">
    <FlowArrow
      class="descent-arrow"
      arrowType={2}
      angleWide="0deg"
      flip
      angleStacked="0deg"
      size={"12rem"}
    />
  </div>
</section>

<style lang="scss">
  @use "../styles/utils" as *;

  .fit-comparison {
    padding: 0 2rem 8rem;
    max-width: var(--xl);
    margin: 0 auto;

    h2 {
      text-align: center;
      font-size: 2rem;
      margin: 0 0 2.5rem;
    }

    .tiers {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem 2rem;
      @include breakpoint-up(md) {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        grid-auto-rows: 1fr;
      }
      .tier-arrow {
        align-self: center;
      }

      .tier {
        height: 100%;
        color: var(--bold-black);
        padding: 1rem;
        h3 {
          margin: 0 0 0.75rem;
          font-size: 1.75rem;
          font-family: var(--handwriting);
          text-align: center;
        }

        p {
          margin: 0 0 0.75rem;
          line-height: 1.6;
          text-align: center;
        }

        .lead {
          font-family: var(--cursive);
          font-size: 1.25rem;
          text-align: center;
          font-weight: 600;
        }

        .note {
          opacity: 0.8;
        }
      }
    }
  }

  .descent {
    display: flex;
    justify-content: center;
    position: relative;
    & :global(.descent-arrow) {
      position: absolute;
      display: flex;
      justify-content: center;
      z-index: 3;
    }
    @include breakpoint-up(md) {
      justify-content: center;
      margin-left: 6rem;
    }
  }
  @include breakpoint-up(md) {
    .flow-arrow {
      display: none;
    }
  }
</style>
