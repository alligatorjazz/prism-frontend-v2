---
// src/components/OurPartners.astro
// Mini version of the full /our-partners page.
// Card grid, logo treatment, shadows and CTA all mirror
// src/pages/our-partners.astro so the two surfaces read as one design.
import { getItems } from "@api/wix";

interface Partner {
  _id: string;
  _owner: string;
  _createdDate: string;
  _updatedDate: string;
  title: string;
  gala: boolean;
  website?: string;
  logo?: string;
  sponsorship?: string[];
  organization: boolean;
  donor: boolean;
}

const PARTNER_COUNT = 5;

const allPartners = (await getItems("Partners")) as unknown as Partner[];

// The previous comment claimed "organization partners" but the code sliced
// the unfiltered list, so donors could appear here.
const organizations = allPartners.filter((p) => p.organization);
const partners = organizations.slice(0, PARTNER_COUNT);

function wixImageUrl(wixImage: string | undefined): string | undefined {
  if (!wixImage) return undefined;
  const match = wixImage.match(/wix:image:\/\/v1\/([^/]+)\/[^#]+/);
  return match ? `https://static.wixstatic.com/media/${match[1]}` : undefined;
}
---

<section class="our-partners-mini ruled-bg">
  <div class="container">
    <h2>Our Partners</h2>
    <p class="intro">
      PRISM prides itself in being a collaborative member of the LGBT community
      in South Florida. These organizations, businesses, and individuals have
      shown their steadfast commitment to our motto: "For Every Color, For
      Everyone" through partnered events, fundraising initiatives, grants,
      sponsorships, and other collaborations.
    </p>

    {
      partners.length > 0 ? (
        <ul class="grid">
          {partners.map((partner) => {
            const logoUrl = wixImageUrl(partner.logo);

            return (
              <li>
                <article class="post-it">
                  {logoUrl ? (
                    <div class="logo">
                      <img src={logoUrl} alt={`${partner.title} logo`} />
                    </div>
                  ) : (
                    <div class="logo placeholder">
                      <span>{partner.title[0]}</span>
                    </div>
                  )}
                  <h3>
                    {partner.website ? (
                      <a
                        href={partner.website}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {partner.title}
                      </a>
                    ) : (
                      partner.title
                    )}
                  </h3>
                </article>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty">No organization partners to display.</p>
      )
    }

    <div class="cta">
      <a href="/our-partners" class="see-all">See All Partners →</a>
    </div>
  </div>
</section>

<style lang="scss">
  .our-partners-mini {
    background-size: 2000px;
    background-repeat: repeat-y;
    background-position: top center;
    padding: 4rem 0;
    font-size: 1.25rem;
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 0 1rem;
  }

  h2 {
    font-size: 3rem;
    position: relative;
    text-align: center;
    margin-bottom: 1rem;
  }

  .intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;

    li article {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      height: 100%;
      transition: transform 0.2s ease;
      filter: var(--shadow-light);

      &:hover {
        transform: translateY(-4px);
        filter: var(--shadow);
        cursor: pointer;
      }

      .logo {
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--cursive);

        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }

        &.placeholder {
          background-color: var(--rainbow-purple);
          color: white;
          font-size: 2rem;
          font-family: var(--handwriting);
          font-weight: bold;
        }
      }

      h3 {
        font-size: 1.25rem;
        text-align: center;
        margin: 0;

        a {
          color: var(--text-color);
          text-decoration: none;
          font-family: var(--cursive);
        }
      }
    }
  }

  .empty {
    text-align: center;
    font-size: 1.25rem;
  }

  .cta {
    text-align: center;
    margin-top: 3rem;
  }

  .see-all {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: var(--rainbow-purple);
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.25rem;
    transition: all 300ms;

    &:hover {
      filter: brightness(110%);
    }
  }
</style>
