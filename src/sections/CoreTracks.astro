---
// src/sections/CoreTracks.astro
// Based on: Membership Model - Section 3: Core Track Pathways
import CoreTrackCard from "@components/CoreTrackCard.astro";
import { faker } from "@faker-js/faker";

// TODO: Replace with actual images from @assets/img/
const outreachImage = faker.image.urlPicsumPhotos({ width: 400, height: 300 });
const policyImage = faker.image.urlPicsumPhotos({ width: 400, height: 300 });
const operationsImage = faker.image.urlPicsumPhotos({
  width: 400,
  height: 300,
});

type Tier = {
  level: number;
  name: string;
  description: string;
  gateway?: string;
};

type Track = {
  title: string;
  description: string;
  levels: ({ role: string; responsibilities: string } | null)[];
};

const tiers: Tier[] = [
  {
    level: 1,
    name: "Volunteer",
    description: "Mobilized for action. Attends events, tabling, phone banks.",
    gateway: "Gateway: Quarterly Orientation OR 1:1 intake",
  },
  {
    level: 2,
    name: "Member",
    description:
      "Actively engaged organizer. Attends All-Member Trainings and participates in a Core Track.",
    gateway: "Gateway: 1:1 intake + track selection",
  },
  {
    level: 3,
    name: "Leader",
    description:
      "Takes ownership of initiatives. Mobilizes others, conducts peer 1:1s, hosts events, manages projects.",
  },
];

const tracks: Track[] = [
  {
    title: "Outreach",
    description: "Mass Outreach & Harm Reduction",
    levels: [
      {
        role: "Volunteer",
        responsibilities:
          "Boots on the ground at tabling; distributes resources and flyers.",
      },
      {
        role: "Member",
        responsibilities:
          "Designs connection spaces; deep organizing conversations at field events.",
      },
      {
        role: "Leader",
        responsibilities:
          "Tabling Lead; co-creates social events; trains new volunteers.",
      },
    ],
  },
  {
    title: "Policy",
    description: "Advocacy & Legislation",
    levels: [
      {
        role: "Volunteer",
        responsibilities: "Signs petitions; presence at school board meetings.",
      },
      {
        role: "Member",
        responsibilities: "Delivers public testimony to lawmakers.",
      },
      {
        role: "Leader",
        responsibilities:
          "Power-mapping workshops; campaign oversight; Lobbying Captain.",
      },
    ],
  },
  {
    title: "People Ops",
    description: "Internal Base-Building",
    levels: [
      null,
      {
        role: "Member",
        responsibilities:
          "Discord stewardship; phonebanks; wellness checks; recruitment.",
      },
      {
        role: "Leader",
        responsibilities:
          "Conducts intake 1:1s; co-facilitates Orientations; rapid-response lead.",
      },
    ],
  },
];
---

<section class="container">
  <div class="content">
    <h2>Ways to Plug In</h2>
    <p class="intro">
      PRISM membership is divided into different core tracks. Each track offers
      distinct activities, skills development, and leadership opportunities.
    </p>
    <div class="stacker">
      <ul class="tiers">
        <li class="spacer"></li>
        {
          tiers.map((tier) => (
            <li class="tier">
              <h3>
                Tier {tier.level}: {tier.name}
              </h3>
              <p>{tier.description}</p>
            </li>
          ))
        }
        <li class="spacer"></li>
      </ul>
      <div class="tracks">
        {
          tracks.map((track) => (
            <div class="track">
              <div class="track-header">
                <h3 class="track-description">{track.title}</h3>
                <p class="track-description">{track.description}</p>
              </div>
              <ul class="track-levels">
                {track.levels.map((level) =>
                  level ? (
                    <li>
                      <p>{level.responsibilities}</p>
                    </li>
                  ) : (
                    <li class="empty-level" />
                  ),
                )}
                <li>
                  <button type="button">Learn More</button>
                </li>
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .container {
    padding: 4rem 2rem;
    background: var(--youth-yellow-2);

    --header-height: 120px;
    .content {
      max-width: 1200px;
      margin: 0 auto;

      margin-bottom: 4rem;
      h2 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }

      .intro {
        text-align: center;
        max-width: 800px;
        margin: 0 auto 3rem auto;
        font-size: 1.1rem;
        line-height: 1.6;
      }
    }
  }

  .stacker {
    flex: 1;
    display: grid;
    width: 100%;
    grid-template-columns: 250px 1fr;
    /* background: rgba(200, 23, 80, 0.2); */
    gap: 1rem;

    .tiers,
    .tracks {
      ul,
      & {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      /* debug */
      /* .tier:nth-child(even), */
      /* .track:nth-child(even) { */
      /*   background: rgba(50, 230, 120, 0.2); */
      /* } */
      /**/
      /* .tier:nth-child(odd), */
      /* .track:nth-child(odd) { */
      /*   background: rgba(120, 40, 200, 0.2); */
      /* } */
    }
  }

  .tiers {
    /* background: rgba(255, 40, 200, 0.1); */
    display: grid;
    grid-template-rows: var(--header-height) 1fr 1fr 1fr;
    gap: 1rem;
  }

  .tracks {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;

    .track {
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      .track-levels {
        flex: 1;
        display: grid;
        grid-template-rows: 1fr 1fr 1fr;
        gap: 1rem;
      }
    }
  }

  .tier,
  .track-levels li {
    padding: 1rem;
    background: white;
    &:last-of-type {
      background: none;
    }
  }

  .empty-level {
    opacity: 0;
  }

  .track-header,
  .spacer {
    height: var(--header-height);
  }

  .tracks > .track {
    /* padding: 1rem; */

    .track-header {
      padding: 1rem;
      text-align: center;
      border-radius: var(--round-edge);
    }

    h3.track-description {
      font-weight: 600;
    }

    button {
      background: var(--activist-aqua);
      border-radius: var(--round-edge);
      width: 100%;
      padding: 1rem;
      font-weight: bold;
    }
  }

  h1 {
    text-align: center;
  }
  h3,
  li,
  ul {
    margin: 0;
    padding: 0;
  }

  /* TODO: replace with color selection */
  .track:nth-child(1) .track-header {
    background: var(--rainbow-orange);
  }
  .track:nth-child(2) .track-header {
    background: var(--rainbow-red);
  }
  .track:nth-child(3) .track-header {
    background: var(--rainbow-blue);
  }
  p {
    font-size: 1.25rem;
    margin: 0;
    padding: 0;
  }
</style>
