---
// src/pages/creative-fellowship.astro
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import TrackIntro from "@sections/TrackIntro.astro";
import speech from "@assets/img/icons/Speech.png";
import alex from "@assets/img/team/alex.avif";

// Fellowship Roles Overview, from the Membership Model.
const fellowshipRoles = [
  {
    title: "Policy Fellow",
    count: "3 (1 per county)",
    description:
      "Break down Florida legislation, school board meetings, elections, and current events into engaging, accessible stories that empower young people to understand policy and take action.",
    quota: "2 original pieces per month",
  },
  {
    title: "Community Fellow",
    count: "3 (1 per county)",
    description:
      "Capture PRISM in action through event coverage, interviews, photography, and storytelling that highlights our volunteers, community partners, and organizing efforts.",
    quota: "2 original pieces per month",
  },
  {
    title: "Health Fellow",
    count: "1",
    description:
      "Develop educational content focused on sexual health, HIV awareness, mental health, and community resources to make health information approachable, affirming, and accessible for young people.",
    quota: "2-3 original pieces per month",
  },
  {
    title: "Culture & Identity Fellow",
    count: "1",
    description:
      "Lead monthly cultural campaigns that celebrate LGBTQ+ identities, heritage months, Pride Days, history, and community stories that foster belonging and representation.",
    quota: "2-3 original pieces per month",
  },
  {
    title: "Copy Editor & Research Fellow",
    count: "1-2",
    description:
      "Ensure every piece of content is accurate, polished, and impactful by supporting research, fact-checking, copy editing, accessibility, and editorial consistency across PRISM's creative campaigns.",
    quota: "Edit ~16 pieces per month",
  },
  {
    title: "Design Fellow",
    count: "2",
    description:
      "Bring PRISM's campaigns to life through engaging visual content, graphic design, and visual storytelling across print and digital to strengthen our brand and support advocacy efforts.",
    quota: "3-4 visual assets per month",
  },
];

const whatFellowsGain = [
  "Serve in a 6-month volunteer leadership role",
  "Attend weekly Creative Fellowship meetings",
  "Participate in trainings, workshops, and educational seminars",
  "Build a professional portfolio through real-world advocacy campaigns",
  "Receive mentorship from nonprofit professionals and community leaders",
  "Join PRISM's growing network of organizers, advocates, and changemakers",
];

const eligibility = [
  "Be a current high school or college student (or equivalent)",
  "Be 24 years old or younger at the start of the Fellowship",
  "Live in Miami, Broward, or Palm Beach County",
  "Have a demonstrated connection to LGBTQ+ youth organizing in Florida",
  "Be able to commit to the full 6-month Fellowship",
];
---

<Base
  pageMetadata={{
    title: "Creative Fellowship",
    description:
      "The PRISM Creative Fellowship is a 6-month volunteer leadership program for LGBTQ+ and allied students under 24 who are passionate about advocacy, organizing, and creative storytelling.",
    type: "website",
    image: speech.src,
    "image:alt": "PRISM Creative Fellowship",
  }}
  class="page-content"
>
  <PageIntro
    title="Creative Fellowship"
    description="The PRISM Creative Fellowship is a 6-month volunteer leadership program designed for LGBTQ+ and allied students under the age of 24 who are passionate about advocacy, organizing, and creative storytelling. Fellows gain real-world experience in nonprofit communications while helping shape PRISM's voice and impact across South Florida."
    image={speech}
    pointBackTo={{ href: "/get-involved/", label: "Get Involved" }}
    class="intro"
  />

  <main>
    <!-- Who leads the program, alongside what it does -->
    <SectionBorder type="marker" backgroundColor="rainbow-green" />

    <TrackIntro
      id="about"
      class="ruled-bg"
      heading="What Is the Fellowship?"
      eyebrow="Program Lead"
      name="Alexander Puga"
      title="Content Creation Director"
      image={alex}
      imageAlt="Portrait of Alexander Puga"
      description="The Creative Fellowship is led by PRISM's Content Creation Director and is designed for students who are passionate about advocacy, organizing, and creative storytelling. Fellows work alongside PRISM's team to create impactful content that educates, inspires, and mobilizes communities across South Florida. Through hands-on projects, mentorship, and professional development, Fellows build a portfolio while helping shape PRISM's voice and impact."
    />

    <SectionBorder type="marker" backgroundColor="rainbow-green" flip />

    <!-- Based on: Membership Model - Fellowship Roles Overview -->
    <section id="roles">
      <div class="container">
        <h3>Fellowship Roles</h3>
        <div class="card-grid">
          {
            fellowshipRoles.map((role) => (
              <article class="card">
                <span class="role-label">{role.title}</span>
                <p class="count">
                  {role.count} fellow{role.count !== "1" ? "s" : ""}
                </p>
                <p>{role.description}</p>
                <p class="quota">
                  <strong>Deliverables:</strong> {role.quota}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Based on: Membership Model - Fellowship Expectations & Eligibility -->
    <section id="expectations">
      <div class="container">
        <h3>What Fellows Gain | Who Should Apply</h3>

        <div class="card-grid two-up">
          <article class="card">
            <h4>What Fellows Gain</h4>
            <ul>
              {whatFellowsGain.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <article class="card">
            <h4>Eligibility</h4>
            <ul>
              {eligibility.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="rainbow-green" />

    <section id="cta" class="ruled-bg">
      <div class="container">
        <h3>Apply for the Creative Fellowship</h3>
        <p>
          Whether you're passionate about writing, photography, graphic design,
          video production, or social media, there's a place for you in the
          Creative Fellowship. Build your portfolio, develop your voice, and
          help shape PRISM's message while growing as a leader and storyteller.
        </p>
        <a href="/apply/creative-fellowship/" class="cta-button">Apply Now</a>
      </div>
    </section>
  </main>

  <style lang="scss">
    .page-content {
      background-color: var(--rainbow-green);
    }

    main {
      margin: auto;
      font-size: 1.25rem;

      h2 {
        font-size: 2rem;
        text-align: center;
      }

      h3 {
        text-align: center;
        font-size: 1.75rem;
      }

      h4 {
        font-size: 1.5rem;
      }
    }

    .container {
      max-width: var(--xl);
      margin: auto;
      padding: 0 1rem;
    }

    .lede {
      font-size: 1.25rem;
      text-align: center;
      font-style: italic;
      max-width: 640px;
      margin: 1rem auto 0;
    }

    /* The intro's <section> is rendered inside TrackIntro.astro, so the scoped
       rules above cannot reach it. The id is unique to this page, so a global
       selector is the honest fix rather than a leak. */
    :global(#about) {
      background-color: var(--rainbow-green);
      background-size: 2100px;
    }

    #roles,
    #expectations {
      background-color: var(--rainbow-green);
      padding: 2rem 0;
      /* color: var(--fg-color); */

      h3 {
        font-size: 3rem;
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
        max-width: var(--lg);
        margin: 2rem auto 0;
      }

      .card-grid.two-up {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .card {
        border: 2px solid var(--fg-color);
        filter: var(--shadow);
        background: var(--rainbow-green);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        color: var(--fg-color);

        h4 {
          margin: 0;
          font-size: 1.5rem;
        }

        p {
          margin: 0;
        }

        ul {
          margin: 0;
          padding-left: 1.25rem;
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }

        .role-label {
          align-self: flex-start;
          background-color: var(--text-color);
          color: var(--fg-color);
          font-family: var(--header-font);
          font-weight: bold;
          padding: 0.25rem 0.75rem;
          border-radius: var(--round-edge);
          text-transform: uppercase;
          font-size: 0.875rem;
        }

        .count {
          font-family: var(--header-font);
          font-weight: bold;
        }

        .quota {
          margin-top: auto;
          font-size: 1rem;
        }
        /* TODO: figure out how to deal with quotas */
        .count,
        .quota {
          display: none;
        }
      }
    }

    #expectations {
      padding-bottom: 6rem;
    }

    #cta {
      padding: 4rem 0;
      background-size: 2100px;

      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: var(--lg);

        p {
          font-size: 1.5rem;
          text-align: center;
        }
      }

      .cta-button {
        display: block;
        margin-top: 1.5rem;
        background-color: var(--rainbow-green);
        color: var(--fg-color);
        padding: 1rem 2rem;
        border-radius: var(--round-edge);
        font-weight: bold;
        font-size: 1.25rem;
        text-align: center;
        text-decoration: none;
        transition: all 300ms;

        &:hover {
          filter: brightness(110%);
        }
      }
    }
  </style>
</Base>
