---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import CenteredPaperWithHeader from "@sections/CenteredPaperWithHeader.astro";
import SectionBorder from "@components/SectionBorder.astro";
import Calendar from "@components/Calendar.astro";
import ThreeIconCluster from "@components/ThreeIconCluster.astro";
import Polaroid from "@components/Polaroid.astro";
import { faker } from "@faker-js/faker";

import ruledBg from "@assets/img/ruled-bg.png";
import creative from "@assets/img/Book_purple.png";

const dummyEvents = Array.from({ length: 12 }).map(() => ({
  title: faker.company.catchPhrase(),
  date: faker.date.soon({ days: 90 }).toISOString(),
  location: faker.location.city(),
  image: null,
  link: faker.internet.url(),
  source: "faker",
  tags: faker.helpers.arrayElements(
    ["Volunteer", "P-SAP", "Creative Fellowship", "Policy"],
    { min: 1, max: 2 },
  ),
}));
---

<Base
  pageMetadata={{
    title: "Creative Fellowship",
    description:
      "The Creative Fellowship is a specialized leadership program for storytellers, designers, and artists helping PRISM advance LGBTQ-inclusive education.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Creative Fellowship"
    description="The PRISM Creative Fellowship is a six-month leadership program for LGBTQ+ high school and college students under the age of 24 who are passionate about advocacy, organizing, and creative storytelling."
    image={creative}
    pointBackTo={{ href: "/task-forces", label: "Task Forces" }}
    class={"intro"}
  />

  <main>
    <CenteredPaperWithHeader title="who?">
      <h2 slot="content">Who makes up the Creative Fellowship?</h2>
    </CenteredPaperWithHeader>

    <SectionBorder type="marker" backgroundColor="rainbow-green" />

    <section id="about" style={{ backgroundImage: `url(${ruledBg.src})` }}>
      <div class="container">
        <h3>About the Fellowship</h3>
        <p>
          The PRISM Creative Fellowship is a six-month leadership program for
          LGBTQ+ high school and college students under the age of 24 who are
          passionate about advocacy, organizing, and creative storytelling.
        </p>
        <p>
          Fellows work alongside PRISM's team to create impactful content that
          educates, inspires, and mobilizes communities across South Florida.
        </p>
        <p>
          Through hands-on projects, mentorship, and workshops, Fellows develop
          skills in writing, design, video production, research, and digital
          advocacy while building a professional portfolio and gaining
          real-world organizing experience.
        </p>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="rainbow-green" flip />

    <section id="impact">
      <div class="container">
        <ThreeIconCluster class={"icons"}>
          <Polaroid
            slot="top"
            image={{
              src: faker.image.urlPicsumPhotos({ width: 250, height: 250 }),
              alt: "Creative Fellow",
              format: "webp",
              width: 250,
              height: 250,
            }}
          />
          <Polaroid
            slot="middle"
            image={{
              src: faker.image.urlPicsumPhotos({ width: 250, height: 250 }),
              alt: "Creative Fellow",
              format: "webp",
              width: 250,
              height: 250,
            }}
          />
          <Polaroid
            slot="bottom"
            image={{
              src: faker.image.urlPicsumPhotos({ width: 250, height: 250 }),
              alt: "Creative Fellow",
              format: "webp",
              width: 250,
              height: 250,
            }}
          />
        </ThreeIconCluster>

        <div class="impact-content">
          <h3>Impact at a Glance</h3>
          <p class="impact-intro">
            From July 2025 through June 2026, the Content Creation Task Force
            transformed PRISM's digital platforms into trusted spaces for LGBTQ+
            education, advocacy, and community engagement.
          </p>

          <div class="stats">
            <article>
              <span class="number">3.9M+</span>
              <span class="label">Total Views</span>
            </article>
            <article>
              <span class="number">421K+</span>
              <span class="label">People Reached</span>
            </article>
            <article>
              <span class="number">95.9K+</span>
              <span class="label">Content Interactions</span>
            </article>
            <article>
              <span class="number">3.8M+</span>
              <span class="label">Organic Views</span>
            </article>
          </div>

          <p>
            Through timely educational campaigns, advocacy-focused storytelling,
            and accessible resources, CCTF helped hundreds of thousands of
            people better understand LGBTQ+ issues, public education, civic
            engagement, and community organizing. These results demonstrate the
            power of strategic storytelling to educate, mobilize, and inspire
            action.
          </p>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="rainbow-green" />

    <section id="roles">
      <div class="container">
        <h3>Fellow Roles</h3>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Role</th>
                <th>Responsibilities</th>
                <th>Time Commitment</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Visual Design Fellow</td>
                <td>
                  Creates graphics, social media assets, and print materials
                  using Adobe Creative Cloud.
                </td>
                <td>5-10 hrs/week</td>
              </tr>
              <tr>
                <td>Video Production Fellow</td>
                <td>
                  Films, edits, and produces video content for campaigns,
                  tutorials, and event coverage.
                </td>
                <td>5-10 hrs/week</td>
              </tr>
              <tr>
                <td>Writing Fellow</td>
                <td>
                  Writes blog posts, social copy, educational resources, and
                  campaign narratives.
                </td>
                <td>5-10 hrs/week</td>
              </tr>
              <tr>
                <td>Photography Fellow</td>
                <td>
                  Captures photos at events and for portraits to support PRISM's
                  visual storytelling.
                </td>
                <td>Event-based</td>
              </tr>
              <tr>
                <td>Brand Strategy Fellow</td>
                <td>
                  Helps shape messaging, campaign themes, and audience
                  engagement strategies.
                </td>
                <td>3-5 hrs/week</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="calendar">
      <Calendar events={dummyEvents} title="Fellowship Calendar" />
    </section>

    <SectionBorder type="marker" backgroundColor="rainbow-green" flip />

    <section id="join">
      <div class="container">
        <div class="content">
          <article>
            <h4>Interested in becoming a Creative Fellow?</h4>
            <p>
              We'd love to have you! You can start by filling out a
              <a href="/volunteer-form">Volunteer Application Form</a>
              or contacting us directly.
            </p>
            <a href="/volunteer-form">Click here to apply!</a>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .page-content {
    background-color: var(--rainbow-green);
  }
  section {
    padding: 4;
  }

  main {
    margin: auto;
    font-size: 1.25rem;

    h2 {
      font-size: 2rem;
      text-align: center;
    }

    h3 {
      font-size: 1.75rem;
    }

    h4 {
      font-size: 1.5rem;
    }
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 0 1rem;
  }

  #about {
    background-color: var(--fg-color);
    padding: 4rem 0;

    p {
      font-size: 1.25rem;
      line-height: 1.6;
    }
  }

  #impact {
    background-color: var(--rainbow-green);
    padding: 4rem 0;
    color: var(--text-color);

    & > .container {
      display: flex;
      align-items: center;
      gap: 3rem;
      width: 100%;
      justify-content: center;
    }

    .icons {
      flex: 1;
    }

    .impact-content {
    }

    .impact-intro {
      font-size: 1.25rem;
      line-height: 1.6;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      margin: 2rem 0;

      article {
        background-color: var(--fg-color);
        border-radius: var(--round-edge);
        padding: 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        .number {
          font-size: 2.5rem;
          font-weight: bold;
          font-family: var(--header-font);
          color: var(--rainbow-green);
        }

        .label {
          font-size: 1rem;
          font-weight: bold;
        }
      }
    }

    p {
      font-size: 1.25rem;
      line-height: 1.6;
    }
  }

  #education {
    background-color: var(--fg-color);
    padding: 4rem 0;

    p {
      font-size: 1.25rem;
      line-height: 1.6;
    }
  }

  #action {
    background-color: var(--rainbow-green);
    padding: 4rem 0;
    color: var(--text-color);

    p {
      font-size: 1.25rem;
      line-height: 1.6;
    }
  }

  #roles {
    background-color: var(--fg-color);
    padding: 4rem 0;

    h3 {
      color: var(--text-color);
    }

    .table-wrapper {
      overflow-x: auto;
      margin-top: 2rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background-color: var(--fg-color);
      border-radius: var(--round-edge);
      overflow: hidden;

      th,
      td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid var(--rainbow-green);
      }

      th {
        background-color: var(--text-color);
        color: var(--fg-color);
        font-family: var(--header-font);
      }

      td {
        color: var(--text-color);
      }

      tr:last-child td {
        border-bottom: none;
      }
    }
  }

  #calendar {
    background-color: var(--fg-color);
    padding: 4rem 0;
  }

  #join {
    background-size: 2000px;
    padding: 4rem 0;

    .content {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;

      article {
        flex: 1;
        min-width: 45%;
        background-color: var(--fg-color);
        filter: var(--shadow);
        padding: 2rem;
        display: flex;
        flex-direction: column;

        h4 {
          height: 2rem;
        }

        p {
          flex: 1;
        }

        & > a:last-of-type {
          background-color: var(--accent-color);
          padding: 0.5rem 1rem;
          border-radius: var(--round-edge);
          color: var(--fg-color);
          font-weight: bold;
          text-align: center;
          text-decoration: none;
          transition: all 300ms;

          &:hover {
            filter: brightness(110%);
          }
        }
      }
    }
  }

  @media (min-width: 768px) {
    #impact .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
