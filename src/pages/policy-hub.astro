---
import BlogPostList from "@components/BlogPostList.astro";
import Base from "../templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import { getCollection } from "astro:content";
import type { PostSummary } from "@datatypes/blog";
import { postToSummary } from "@lib/blog";
import scale from "@assets/img/book-scale.png";
const allPosts = await getCollection("blog");
const policyHubArticles: PostSummary[] = allPosts
  .filter((post) =>
    post.data.tags.some((tag) =>
      [
        "School Policy Hub",
        "SPH - Parents",
        "SPH - Students",
        "SPH - Teachers",
      ].includes(tag),
    ),
  )
  .map((post) => postToSummary(post));
---

<Base
  pageMetadata={{
    title: "Website",
    description: "Test",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="School Policy Hub"
    description="The School Policy Hub is your go-to guide for navigating LGBTQ+ rights and policies in Florida schools. It brings together current state laws, local district rules, and practical strategies for advocacy in Miami-Dade, Broward, and Palm Beach Counties. Whether you’re a student, parent, or educator, the Hub offers clear, accessible information to help you understand your rights, respond to challenges, and create safer school environments."
    image={scale}
    pointBackTo={{ href: "/about", label: "About" }}
  />

  <main>
    <iframe
      src="https://school-policy-hub-embed.ops.retrocolosseum.org/"
      class="embed"></iframe>
    <div class="all-articles ruled-bg">
      <div class="content">
        <h1>All Articles</h1>
        <BlogPostList posts={policyHubArticles} />
      </div>
    </div>
  </main>
</Base>

<style>
  .page-content {
    background-color: var(--rainbow-blue);
  }
  main {
    background: var(--rainbow-blue);
    display: flex;
    flex-direction: column;
    align-items: center;
    .embed {
      border: 0;
      width: var(--2xl);
      height: 1100px;
    }
    .all-articles {
      width: 100%;
      .content {
        margin: auto;
        width: var(--lg);
        padding: 2rem;
        h1 {
          text-align: center;
        }
      }
    }
  }
</style>
