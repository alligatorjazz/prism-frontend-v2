---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import donateImage from "@assets/img/giving-icon.avif";
import ruledBg from "@assets/img/ruled-bg.png";
import { getImage } from "astro:assets";
const ruledPaper = `url( ${(await getImage({ src: ruledBg, format: "webp" })).src})`;
---

<Base
  pageMetadata={{
    title: "Donate",
    image: "https://picsum.photos/200",
    "image:alt": "test",

    description:
      "PRISM allocates 100% of the money it receives towards assisting LGBTQ+ youth in South Florida. Donate today!",
    type: "website",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Donate"
    description="PRISM allocates 100% of the money it receives towards assisting LGBTQ+ youth in South Florida."
    image={donateImage}
    pointBackTo={{ href: "/", label: "Home" }}
    class={"intro"}
  />

  <SectionBorder type="wave-left" backgroundColor="#74bf44" />
  <main>
    <section id="one-time" style={{ backgroundImage: ruledPaper }}>
      <div class="container">
        <h2>One-Time or Recurring Donation</h2>
        <p>
          Make a secure donation to support LGBTQ+ youth in South Florida. Every
          dollar goes directly to our programs and services.
        </p>
        <a
          href="https://prismfl.app.neoncrm.com/forms/donate?campaignId=2"
          class="cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          Donate Now
        </a>
      </div>
    </section>

    <SectionBorder type="wave-right" backgroundColor="#74bf44" flip />

    <section id="movement-builders">
      <div class="container">
        <h2>Become a Movement Builder</h2>
        <p>
          Take your support to the next level and become a Movement Builder with
          our membership plan. Get access to exclusive member benefits like
          hand-drawn queer art, collector's items, a special newsletter, and
          more.
        </p>

        <div class="options">
          <article>
            <h3>For Individuals</h3>
            <div class="buttons">
              <a href="/movement-builders-monthly" class="cta">Donate Monthly</a
              >
              <a href="/movement-builders-yearly" class="cta">Donate Yearly</a>
            </div>
          </article>

          <article>
            <h3>For Businesses</h3>
            <a href="/movement-builders-business" class="cta">
              Business Sponsorship
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>

<style lang="scss">
  .page-content {
    background-color: var(--rainbow-green);
  }

  main {
    margin: auto;
    font-size: 1.25rem;
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 4rem 1rem;
    text-align: center;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  p {
    max-width: 700px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .cta {
    display: inline-block;
    background-color: var(--accent-color);
    color: var(--fg-color);
    padding: 0.75rem 1.5rem;
    border-radius: var(--round-edge);
    text-decoration: none;
    font-weight: bold;
    transition: filter 0.2s ease;

    &:hover {
      filter: brightness(110%);
    }
  }

  #one-time {
    background-size: 2000px;

    padding: 4rem 0;
  }

  #movement-builders {
    background-color: var(--rainbow-green);
    color: white;

    h2 {
      color: white;
    }

    .options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 2rem;

      article {
        background: white;
        color: var(--text-color);
        border-radius: var(--round-edge);
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;

        h3 {
          font-size: 1.5rem;
          margin: 0;
        }

        .buttons {
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          justify-content: center;
        }
      }
    }
  }
</style>
