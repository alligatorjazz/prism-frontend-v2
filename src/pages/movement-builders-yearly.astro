---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import TierGrid from "@components/TierGrid.astro";

import fistSticker from "@assets/img/fist-sticker.avif";

const baseBenefits = ["Exclusive Movement Builders Monthly Newsletter"];

const tiers = [
  { name: "Supporter", price: "$60", frequency: "yr", benefits: baseBenefits },
  { name: "Friend", price: "$120", frequency: "yr", benefits: baseBenefits },
  { name: "Ally", price: "$300", frequency: "yr", benefits: baseBenefits },
  { name: "Advocate", price: "$600", frequency: "yr", benefits: baseBenefits },
  {
    name: "Champion",
    price: "$1,200",
    frequency: "yr",
    benefits: baseBenefits,
  },
  {
    name: "Legend",
    price: "$3,000",
    frequency: "yr",
    benefits: baseBenefits,
    highlighted: true,
  },
].map((tier) => ({
  ...tier,
  ctaHref: "https://prismfl.app.neoncrm.com/forms/21?utm_source=web",
  ctaLabel: "Become a Movement Builder",
}));
---

<Base
  pageMetadata={{
    title: "Movement Builders: Yearly Membership",
    description:
      "Starting at just $60/year, each donorship tier comes with exciting perks and opportunities.",
    type: "website",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Movement Builders: Yearly Membership"
    description="Starting at just $60/year, each donorship tier comes with exciting perks and opportunities, as well as an exclusive monthly newsletter featuring an LGBTQ+ advice column and queer culture news. Show your commitment to South Florida's LGBTQ+ youth and sign up today!"
    image={fistSticker}
    pointBackTo={{ href: "/donate", label: "Donate" }}
    class={"intro"}
  />

  <main>
    <SectionBorder
      type="cookie-cutter"
      backgroundColor="var(--rainbow-green)"
    />

    <section id="tiers">
      <div class="container">
        <TierGrid tiers={tiers} />
      </div>
    </section>

    <SectionBorder
      type="cookie-cutter"
      backgroundColor="var(--rainbow-green)"
      flip
    />

    <section id="note">
      <div class="container">
        <p class="note">
          Note: Newsletter perks are immediately accessible. Physical prizes and
          gala-related perks will be received seasonally.
        </p>
      </div>
    </section>
  </main>
</Base>

<style lang="scss">
  .page-content {
    background-color: var(--rainbow-green);
  }

  main {
    margin: auto;
    font-size: 1.25rem;
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 4rem 1rem;
  }

  #tiers {
    padding: 4rem 1rem;
    background-color: white;
  }

  #note {
    background-color: var(--rainbow--green);
    color: white;
    text-align: center;

    .note {
      max-width: 700px;
      margin: 0 auto;
      font-style: italic;
    }
  }
</style>
