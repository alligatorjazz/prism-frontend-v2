---
import Base from "@templates/Base.astro";
import { faker } from "@faker-js/faker";

const staff = {
  contentCreation: {
    name: "Alexander Puga",
    role: "Content Creation Director",
    bio: "A Miami-born creative with a passion for storytelling that uplifts and represents marginalized communities. With a background in film, content creation, and brand strategy, Alex brings bold visuals and culturally rooted narratives to life. He has led campaigns for local businesses, fashion brands, and queer initiatives. As Content Creation Director at PRISM, Alex is here to celebrate queer voices and create space for joy and identity across every platform. Outside of work, you'll find him biking around the city, sweating through a workout, singing, or hanging with his fiance and their two pups, Nino and Winston.",
    image: faker.image.avatarGitHub(),
  },
  fundraising: {
    name: "Hannah Neuman",
    role: "Development & Operations Director",
    bio: 'Hannah is a genderqueer lesbian from Jacksonville, FL with a BSc from Florida State University. They have an extensive background in education and youth empowerment, and a deep passion for community-building. Over the last three years, they have co-directed two small non-profits focused on uplifting houseless individuals and local artists by expanding access to vital resources. Hannah is currently plans to pursue a Masters of Social Work in 2026. As a Jewish member of the queer community, they are dedicated to Collective Liberation—actively uplifting Palestinian voices in their fight for freedom at every opportunity. In addition to advocacy work, Hannah enjoys practicing astrology, tarot, art, and vegan cooking. In their free time, you can often find them taking a long hike through nature, working on a magazine collage, or performing with their indie-rock band "No Parts".',
    image: faker.image.avatarGitHub(),
  },
  outreach: {
    name: "Avion Goordeen",
    role: "Outreach Director",
    bio: "Avion is a bisexual man and a first-generation immigrant from the Caribbean islands of Trinidad and Tobago. He has a Master's in Ocean Engineering from Florida Atlantic University and has been involved in LGBTQ+ activism and leadership since 2018. This includes working with CompassGLCC and being a member of the board of directors of Night Runners WPB. In his free time, Avion enjoys paddleboarding, photography and is currently a fan of the manga, One Piece.",
    image: faker.image.avatarGitHub(),
  },
  policy: {
    name: "Miles Davis",
    role: "Policy Analyst",
    bio: "Miles Davis has a diverse background in legislative affairs, voting rights advocacy, and political campaigns. He served as Chief of Staff in the Florida Senate, where he provided strategic guidance on policy initiatives and built strong relationships with community leaders and state agencies. As Florida Voting Rights Director at America Votes, Miles worked to protect and expand voter access, collaborating with state and local stakeholders to create coordinated strategies. He has also led teams on high-profile political campaigns, serving as a Political Director and Campaign Manager for statewide and regional efforts. Miles is passionate about empowering communities, advancing civic engagement, and fostering equitable opportunities for all.",
    image: faker.image.avatarGitHub(),
  },
  psap: {
    name: "Auxmary Valdez",
    role: "P-SAP Manager",
    bio: "Auxmary Valdez is a queer woman and daughter of first-generation Venezuelan and Nicaraguan immigrants. She is a former sex educator and current University of Central Florida student, double majoring in Political Science and Biomedical Sciences.",
    image: faker.image.avatarGitHub(),
  },
};
---

<Base
  pageMetadata={{
    title: "Task Forces",
    description: "See the meat and potatoes of PRISM's work.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
>
  <section id="introduction">
    <h1>Task Forces</h1>
    <p>
      PRISM's work takes place in five task forces. Read about any of them below
      to learn more and see how you can get involved!
    </p>
  </section>

  <nav id="internal-nav">
    <a href="#content-creation">Content Creation</a>
    <a href="#outreach">Outreach</a>
    <a href="#fundraising">Fundraising</a>
    <a href="#policy">Policy</a>
    <a href="#psap">PSAP</a>
  </nav>

  <section class="task-force" id="content-creation">
    <div class="container">
      <div class="info">
        <div class="text">
          <h1>Content Creation Task Force</h1>
          <p>
            The Content Creation Task Force is the backbone of the work PRISM
            does, providing LGBT-inclusive education and other resources where
            young people turn to most: online. From cracking open the history
            books to tell us all about <a href="/post/stonewall-riots"
              >the Stonewall riots</a
            > to helping us define exactly what differentiates <a
              href="/post/sex-vs-gender">sex from gender</a
            > (Hint: a lot), our team helps us keep you informed.
          </p>
          <p>
            The Content Creation Task Force also keeps PRISM looking its best!
            From social media posts to the website you're on now, everything
            your eyes take in was made by these Adobe wizards and photography
            experts.
          </p>
        </div>
        <div class="image">
          <img
            src="https://static.wixstatic.com/media/55a8ce_012602e39cb342b5b6a3da8aa21918ea~mv2.png"
            alt="Computer illustration"
            width="379"
            height="237"
          />
        </div>
      </div>

      <div class="team-member">
        <div class="image">
          <img
            src={staff.contentCreation.image}
            alt={`Portrait of ${staff.contentCreation.name}`}
            width="328"
            height="371"
          />
        </div>
        <div class="text">
          <div class="topline">
            <h2>{staff.contentCreation.name}</h2>
            <p>{staff.contentCreation.role}</p>
          </div>
          <div class="description">
            <p>{staff.contentCreation.bio}</p>
          </div>
        </div>
      </div>

      <div class="get-involved">
        <h2>Get involved with our work!</h2>
        <a class="button" href="/task-forces/content-creation-task-force"
          >Learn More</a
        >
      </div>
    </div>
  </section>

  <section class="task-force" id="outreach">
    <div class="container">
      <div class="info">
        <div class="text">
          <h1>Outreach Task Force</h1>
          <p>
            The Outreach Task Force coordinates events and other activities to
            spread awareness of the amazing work PRISM does and builds
            connections with the community.
          </p>
          <p>
            Our outreach correspondants are spreading the word, one connection
            at a time.
          </p>
        </div>
        <div class="image">
          <img
            src="https://static.wixstatic.com/media/9eef37_1f8d795aa8074d60a6aa990af7a14a66~mv2.png"
            alt="Megaphone illustration"
            width="308"
            height="274"
          />
        </div>
      </div>

      <div class="team-member">
        <div class="image">
          <img
            src={staff.outreach.image}
            alt={`Portrait of ${staff.outreach.name}`}
            width="328"
            height="371"
          />
        </div>
        <div class="text">
          <div class="topline">
            <h2>{staff.outreach.name}</h2>
            <p>{staff.outreach.role}</p>
          </div>
          <div class="description">
            <p>{staff.outreach.bio}</p>
          </div>
        </div>
      </div>

      <div class="get-involved">
        <h2>Get involved with our work!</h2>
        <ul>
          <li>
            <a class="button" href="/volunteer-form"
              >Volunteer Application Form</a
            >
          </li>
          <li>
            <a class="button" href="/contact">Contact us directly</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="task-force" id="fundraising">
    <div class="container">
      <div class="info">
        <div class="text">
          <h1>Fundraising Task Force</h1>
          <p>
            The Fundraising Task Force works to develop events and promotions
            that bring in funding for all of the many initiatives and services
            that PRISM provides to LGBTQ+ youth and queer people of color.
          </p>
          <p>
            From bake sales to fun runs to livestreams, these dedicated
            individuals work hard to keep the blood pumping through PRISM's
            veins.
          </p>
        </div>
        <div class="image">
          <img
            src="https://static.wixstatic.com/media/55a8ce_57f5071b7bce4e77a7e2ad809bd451d6~mv2.png"
            alt="Giving icon"
            width="367"
            height="253"
          />
        </div>
      </div>

      <div class="team-member">
        <div class="image">
          <img
            src={staff.fundraising.image}
            alt={`Portrait of ${staff.fundraising.name}`}
            width="328"
            height="371"
          />
        </div>
        <div class="text">
          <div class="topline">
            <h2>{staff.fundraising.name}</h2>
            <p>{staff.fundraising.role}</p>
          </div>
          <div class="description">
            <p>{staff.fundraising.bio}</p>
          </div>
        </div>
      </div>

      <div class="get-involved">
        <h2>Get involved with our work!</h2>
        <ul>
          <li>
            <a
              class="button"
              href="https://prismfl.app.neoncrm.com/forms/movement-builders"
              >Sign up for Movement Builders!</a
            >
          </li>
          <li>
            <a class="button" href="/donate">Donate</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="task-force" id="policy">
    <div class="container">
      <div class="info">
        <div class="text">
          <h1>Policy Task Force</h1>
          <p>
            PRISM's Policy Task Force works to advance innovative laws and
            policies and pushes back against bad bills to ensure that no one
            suffers discrimination or harassment on the basis of their sexual
            orientation, race, or gender identity.
          </p>
          <p>
            The Policy Task Force solves challenges at the local, state, and
            national levels, with an emphasis on fighting for the LGBTQ+
            community, especially LGBTQ+ people of color across South Florida.
          </p>
        </div>
        <div class="image">
          <img
            src="https://static.wixstatic.com/media/55a8ce_bcce57555471485ab9935becc1638858~mv2.png"
            alt="Scale of justice illustration"
            width="325"
            height="312"
          />
        </div>
      </div>

      <div class="team-member">
        <div class="image">
          <img
            src={staff.policy.image}
            alt={`Portrait of ${staff.policy.name}`}
            width="328"
            height="371"
          />
        </div>
        <div class="text">
          <div class="topline">
            <h2>{staff.policy.name}</h2>
            <p>{staff.policy.role}</p>
          </div>
          <div class="description">
            <p>{staff.policy.bio}</p>
          </div>
        </div>
      </div>

      <div class="get-involved">
        <h2>Get involved with our work!</h2>
        <a class="button" href="/task-forces/policy-task-force">Learn More</a>
      </div>
    </div>
  </section>

  <section class="task-force" id="psap">
    <div class="container">
      <div class="info">
        <div class="text">
          <h1>PRISM Student Ambassador Program</h1>
          <p>
            With attacks against LGBTQ+ youth across the state, extracurricular
            programs and clubs will be even more of a safe haven for queer
            students.
          </p>
          <p>
            As the school year approaches, consider becoming part of PRISM's
            Student Ambassador Program!
          </p>
          <p>
            The PRISM Student Ambassador Program (P-SAP) is a network of GSAs
            (Gender and Sexuality Alliances) and other LGBTQ+ student
            organizations empowering the next generation of leaders.
          </p>
        </div>
        <div class="image">
          <img
            src={faker.image.url({ width: 500, height: 500 })}
            alt="PSAP illustration"
            width="500"
            height="500"
          />
        </div>
      </div>

      <div class="team-member">
        <div class="image">
          <img
            src={staff.psap.image}
            alt={`Portrait of ${staff.psap.name}`}
            width="328"
            height="371"
          />
        </div>
        <div class="text">
          <div class="topline">
            <h2>{staff.psap.name}</h2>
            <p>{staff.psap.role}</p>
          </div>
          <div class="description">
            <p>{staff.psap.bio}</p>
          </div>
        </div>
      </div>

      <div class="get-involved">
        <h2>Get involved with our work!</h2>
        <a class="button" href="/psap">Learn More</a>
      </div>
    </div>
  </section>
</Base>

<style>
  #introduction {
    color: white;
    text-align: center;
    padding: 2rem;
    h1 {
      font-size: 3rem;
      margin: 0;
    }
    p {
      margin: 0;
      font-size: 1.5rem;
    }
  }

  #internal-nav {
    width: 100%;
    display: flex;
    position: sticky;
    top: 10rem;
    background: var(--bg-color);
    transition: all 300ms;
    a {
      padding: 1rem;
      display: block;
      border-right: 1px solid white;
      border-bottom: 1px solid white;
      flex: 1;
      text-align: center;
      font-weight: bold;
      &:last-child {
        border-right: 0;
      }
      font-family: var(--header-font);
      text-decoration: none;
      color: white;
      &:visited {
        color: white;
      }
    }
  }

  body[data-prev-scroll="down"] #internal-nav {
    top: 0rem;
  }

  #content-creation {
    color: black;
    background: #fbed1f;
  }

  #outreach {
    color: white;
    background: #f19221;
  }

  #fundraising {
    color: white;
    background: #74bf44;
  }

  #policy {
    color: white;
    background: #d02c28;
  }

  #psap {
    color: white;
    background: #854e9e;
  }

  .task-force {
    padding: 2rem;
    width: 100%;
    .container {
      margin: auto;
      max-width: var(--xl);
    }

    .info {
      display: flex;
      align-items: center;
      gap: 2rem;
      .text {
        flex: 1;
        h1 {
          padding-bottom: 1rem;
          font-size: 2.5rem;
          border-bottom: 2px solid white;
        }
        p {
          font-size: 1.5rem;
        }
      }
      .image {
        width: 30%;
        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
      }
    }

    .team-member {
      display: flex;
      align-items: center;
      gap: 2rem;

      .text {
        flex: 1;
        p {
          font-size: 1.5rem;
        }

        .topline {
          h2 {
            font-size: 2rem;
            margin: 0;
          }
          p {
            margin: 0;
            font-style: italic;
          }
          padding-bottom: 1rem;
          border-bottom: 2px solid white;
        }
      }

      .image {
        width: 30%;
        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
      }
    }

    .get-involved {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4rem;

      a,
      li > a {
        text-decoration: none;
        background-color: var(--accent-color);
        font-size: 1.5rem;
        padding: 0.5rem 1rem;
        border-radius: var(--round-edge);
        color: var(--fg-color);
        &:hover {
          filter: brightness(110%);
        }
      }
      /* a:visited { */
      /*   color: initial; */
      /* } */
      h2 {
        font-size: 2rem;
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-size: 1.5rem;
        list-style: none;
        margin: 0;
      }
    }
  }
</style>
