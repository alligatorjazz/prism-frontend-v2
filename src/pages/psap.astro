---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import CenteredPaperWithHeader from "@sections/CenteredPaperWithHeader.astro";
import SectionBorder from "@components/SectionBorder.astro";
import Polaroid from "@components/Polaroid.astro";
import { Image } from "astro:assets";
import { faker } from "@faker-js/faker";
import psapFlag from "@assets/img/rainbow-flag.avif";
import img1 from "@assets/img/psap-table.avif";
import img2 from "@assets/img/psap-indoors.avif";
import img3 from "@assets/img/psap-church.avif";
import gsaNetwork from "@assets/img/gsa-network.avif";
import psapGroup from "@assets/img/psap-group.avif";
import psapLeadersCouncil from "@assets/img/psap-leaders-council.avif";
import PostIt from "@components/PostIt.astro";
---

<Base
  pageMetadata={{
    title: "Student Ambassador Program",
    description:
      "The PRISM Student Ambassador Program (P-SAP) is a network of GSAs and other LGBTQ+ student organizations empowering the next generation of leaders.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="PRISM Student Ambassador Program"
    description="With attacks against LGBTQ+ youth across the state, extracurricular programs and clubs will be even more of a safe haven for queer students. As the school year approaches, consider becoming part of PRISM's Student Ambassador Program!"
    image={psapFlag}
    pointBackTo={{ href: "/task-forces", label: "Task Forces" }}
    class={"intro"}
  />

  <main>
    <SectionBorder type="marker" backgroundColor="bold-black" flip />
    <section id="about">
      <div class="content">
        <div class="image">
          <Polaroid
            image={{
              src: psapGroup,
              alt: "A photo of several people marching with a PRISM FL branded banner.",
            }}
            label="What is the PRISM Student Ambassador Program?"
            class="polaroid"
          />
        </div>
        <div class="description">
          <p>
            The PRISM Student Ambassador Program (P-SAP) is a network of GSAs
            (Gender and Sexuality Alliances) and other LGBTQ+ student
            organizations empowering the next generation of leaders.
          </p>
        </div>
      </div>
    </section>
    <SectionBorder type="marker" backgroundColor="bold-black" />
    <section id="benefits" class="ruled-bg">
      <div class="content">
        <h1>By joining P-SAP, you get:</h1>
        <div class="grid">
          <Polaroid
            class={"polaroid"}
            image={{ src: img1, alt: "placeholder" }}
          />
          <PostIt class={"benefit"}
            ><p>
              Individual support to start, sustain, or grow your club
            </p></PostIt
          ><PostIt class={"benefit small"}
            ><p>Access to guest speakers for your club meetings</p></PostIt
          >
          <PostIt class={"benefit small"}
            ><p>Cash stipend for your club <i>(yes, real money)</i></p></PostIt
          >

          <PostIt class={"benefit"}
            ><p>
              The opportunity to actively connect with other LGBTQ+ student
              leaders through monthly meetings and an exclusive P-SAP chat
            </p></PostIt
          >
          <Polaroid
            class={"polaroid"}
            image={{ src: img2, alt: "placeholder" }}
          />
          <PostIt class={"benefit"}
            ><p>
              Workshops and trainings on topics like community organizing,
              LGBTQ+ history, and more
            </p></PostIt
          >
          <PostIt class={"benefit"}
            ><p>
              Guidance on laws and policies that might affect your clubs and
              club members
            </p></PostIt
          >
          <Polaroid
            class={"polaroid"}
            image={{ src: img3, alt: "placeholder" }}
          />
        </div>
      </div>
    </section>
  </main>

  <style>
    .page-content {
      background-color: var(--rainbow-purple);
    }

    main {
      margin: auto;
      font-size: 1.25rem;
    }
    section > .content {
      max-width: var(--lg);
      margin: auto;
      padding: 2rem;
    }

    #about {
      background: var(--bold-black);
      color: var(--witty-white);

      .content {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        column-gap: 2rem;
        width: 100%;
        height: 100%;

        .image {
          & > .polaroid p {
            font-size: 2rem;
            color: var(--bold-black);
          }
        }
        .description {
          min-width: 35%;
          font-size: 2rem;
          text-align: center;
        }
      }
    }

    #benefits {
      .content {
        h1 {
          width: 100%;
          text-align: center;
        }
        .grid {
          display: grid;
          grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
          width: 100%;
          grid-gap: 2rem;
          .benefit:not(.small) {
            grid-column: span 2;
          }
          .polaroid {
            grid-column: span 2;
            max-height: 450px;
            img {
              object-fit: cover;
              object-position: top;
            }
          }

          .benefit:last-of-type {
            grid-column: span 3;
          }

          .polaroid:last-of-type {
            grid-column: span 4;
          }
        }
      }
      .benefit {
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
      }
    }
  </style>
</Base>
