---
// src/pages/yac.astro
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import TrackIntro from "@sections/TrackIntro.astro";
import TornPaperBox from "@components/TornPaperBox.astro";
import fist1 from "@assets/img/stickers/fist_1-sticker.png";
import maxx from "@assets/img/team/maxx.avif";

// Condensed from the "Key Components" list already on this page.
const activities = [
  {
    title: "Board Governance",
    description:
      "Members meet monthly with the YAC Chair and Executive Director to review board governance and organizational strategy, learning how a nonprofit is actually run.",
  },
  {
    title: "Real Recommendations",
    description:
      "The committee is a bridge between PRISM's youth members and its Board of Directors. Members make recommendations that shape PRISM's organizational direction and impact across South Florida.",
  },
  {
    title: "Leadership Development",
    description:
      "Members build hands-on skills in nonprofit management, governance, and community-led decision-making, and connect with PRISM's Board of Directors and community partners.",
  },
];
---

<Base
  pageMetadata={{
    title: "Youth Advisory Committee",
    description:
      "The Youth Advisory Committee (YAC) will be a 9-month program for nonprofit governance and board recommendations, empowering the next generation of LGBTQ+ leaders in South Florida.",
    type: "website",
    image: fist1.src,
    "image:alt": "Youth Advisory Committee",
  }}
  class="page-content"
>
  <PageIntro
    title="Youth Advisory Committee"
    description="The Youth Advisory Committee (YAC) is a 9-month program designed to develop the next generation of LGBTQ+ nonprofit leaders. YAC members gain hands-on experience in nonprofit governance, strategic planning, and board leadership while making real recommendations that shape PRISM's direction and impact across South Florida."
    image={fist1}
    pointBackTo={{ href: "/get-involved/", label: "Get Involved" }}
    class="intro"
  />

  <main>
    <section class="cta">
      <div class="container">
        <TornPaperBox>
          <h1 style={{ textAlign: "center" }}>Coming soon!</h1>
        </TornPaperBox>
      </div>
    </section>
  </main>
</Base>

<style lang="scss">
  .intro {
    :global(*, hr) {
      color: var(--bold-black);
    }
  }

  .page-content {
    background-color: var(--youth-yellow-2);
  }

  main {
    margin: auto;
    font-size: 1.25rem;

    h2 {
      font-size: 2rem;
      text-align: center;
    }

    h3 {
      text-align: center;
      font-size: 1.75rem;
    }

    h4 {
      font-size: 1.5rem;
    }
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 0 1rem;
  }

  /* The intro's <section> is rendered inside TrackIntro.astro, so the scoped
       rules above cannot reach it. The id is unique to this page, so a global
       selector is the honest fix rather than a leak. */
  :global(#about) {
    background-color: var(--youth-yellow-2);
    background-size: 2100px;
  }

  #program {
    background-color: var(--youth-yellow-2);
    padding: 4rem 0;

    .program-content {
      display: flex;
      justify-content: center;
      margin-top: 2rem;
    }

    h4 {
      color: var(--text-color);
    }

    ul {
      list-style: disc;
      padding-left: 1.5rem;
      color: var(--text-color);
      line-height: 1.8;
    }
  }

  #cta {
    padding: 4rem 0;
    background-size: 2100px;

    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: var(--lg);
    }

    p {
      font-size: 1.5rem;
      text-align: center;
    }

    .cta-button {
      display: block;
      margin-top: 1.5rem;
      background-color: var(--youth-yellow-2);
      color: var(--text-color);
      padding: 1rem 2rem;
      border-radius: var(--round-edge);
      font-weight: bold;
      font-size: 1.25rem;
      text-align: center;
      text-decoration: none;
      transition: all 300ms;

      &:hover {
        filter: brightness(110%);
      }
    }
  }
</style>
