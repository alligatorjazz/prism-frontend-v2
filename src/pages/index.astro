---
import Base from "../templates/Base.astro";
import CardsWithHeader from "../sections/CardsWithHeader.astro";
import EventsWithHeader from "../sections/EventsWithHeader.astro";
import ruledBg from "../assets/img/ruled-bg.png";
import OurPartners from "../sections/OurPartners.astro";
import HeroVideo from "../sections/HeroVideo.astro";
import { faker } from "@faker-js/faker";
import AlternatingRibbons from "../sections/AlternatingRibbons.astro";
---

<Base
  pageMetadata={{
    title: "Website",
    description: "Test",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
>
  <HeroVideo />
  <!-- <PaperWithPolaroids title="Who We Are" /> -->
  <CardsWithHeader
    title="Resources"
    cards={[
      {
        label: "Learn",
        href: "/",
        backgroundColor: "gold",
      },
      {
        label: "Student Ambassador Program",
        href: "/",
        backgroundColor: "purple",
      },
      {
        label: "Get Tested",
        href: "/",
        backgroundColor: "pink",
      },
      {
        label: "School Policy Hub",
        href: "/",
        backgroundColor: "skyblue",
      },
    ]}
    backgroundImage={ruledBg.src}
  />

  <AlternatingRibbons
    ribbons={[
      {
        title: "Outreach",
        color: "var(--rainbow-orange)",
        description: faker.lorem.sentences(2),
      },
      {
        title: "Policy",
        color: "var(--rainbow-red)",
        description: faker.lorem.sentences(2),
      },
      {
        title: "Creative Fellowship",
        color: "var(--rainbow-green)",
        description: faker.lorem.sentences(2),
      },
      {
        title: "Student Ambassador Program",
        color: "var(--rainbow-purple)",
        description: faker.lorem.sentences(2),
      },
    ]}
    backgroundImage={ruledBg.src}
  />
  <EventsWithHeader title="Upcoming Events" } backgroundImage={ruledBg.src} />
  <OurPartners />
</Base>

<style>
  #animated-hero {
    /* temp */
    height: 60vh;
    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
