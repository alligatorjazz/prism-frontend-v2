---
import Base from "../templates/Base.astro";
import StickersWithHeader from "@sections/StickersWithHeader.astro";
import EventsWithHeader from "@sections/EventsWithHeader.astro";
import ruledBg from "@assets/img/ruled-bg.png";
import HeroVideo from "@sections/HeroVideo.astro";
import { faker } from "@faker-js/faker";
import AlternatingRibbons from "@sections/AlternatingRibbons.astro";
import ColoredHeader from "@components/ColoredHeader.astro";
import book from "@assets/img/stickers/book-sticker.png";
import scale from "@assets/img/stickers/scale-sticker.png";
import sti from "@assets/img/stickers/blood_drop-sticker.png";
---

<Base
  pageMetadata={{
    title: "Website",
    description: "Test",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
>
  <HeroVideo />
  <ColoredHeader borderTop="marker" borderBottom="marker"
    ><slot name="header"><h1 class="cards-header">Resources</h1></slot
    ></ColoredHeader
  >
  <StickersWithHeader
    title="test"
    backgroundImage={ruledBg}
    stickers={[
      { title: "Learn", image: book, href: "/learn" },
      {
        title: "School Policy Hub",
        image: scale,
        href: "/policy-hub",
        arrow: "bottom-right",
      },
      {
        title: "STI Clinic Search",
        image: sti,
        href: "/std-clinics",
        arrow: "top-right",
      },
    ]}
  />

  <ColoredHeader borderTop="marker" borderBottom="marker"
    ><slot name="header"><h1 class="cards-header">Get Involved</h1></slot
    ></ColoredHeader
  >
  <StickersWithHeader
    title="test"
    backgroundImage={ruledBg}
    stickers={[
      { title: "Outreach", image: sti, href: "/outreach", hideArrow: true },
      {
        title: "Policy",
        image: sti,
        href: "/policy",
        arrow: "top-right",
        hideArrow: true,
      },
      {
        title: "Creative Fellowship",
        image: sti,
        href: "/creative-fellowship",
        arrow: "bottom-right",
        hideArrow: true,
      },
      {
        title: "Student Ambassador Program",
        image: sti,
        href: "/psap",
        arrow: "top-right",
        hideArrow: true,
      },
    ]}
  />

  <EventsWithHeader title="Upcoming Events" } backgroundImage={ruledBg.src} />
  <!-- <OurPartners /> -->
</Base>

<style>
  #animated-hero {
    /* temp */
    height: 60vh;
    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cards-header {
      margin-bottom: 1rem;
    }
  }
</style>
