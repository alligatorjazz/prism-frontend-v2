---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import { getItems } from "@api/wix";
import ScribbleSeparator from "@components/ScribbleSeparator.astro";
import Paginator from "@components/Paginator.astro";
import BigButton from "@components/BigButton.astro";
import TornPaperBox from "@components/TornPaperBox.astro";

interface Partner {
  _id: string;
  _owner: string;
  _createdDate: string;
  _updatedDate: string;
  title: string;
  gala: boolean;
  website?: string;
  logo?: string;
  sponsorship?: string[];
  organization: boolean;
  donor: boolean;
}

const ITEMS_PER_PAGE = 8;

const allPartners: Partner[] = (await getItems(
  "Partners",
)) as unknown as Partner[];

const organizations = allPartners.filter((p) => p.organization);
const donors = allPartners.filter((p) => p.donor);

function wixImageUrl(wixImage: string | undefined): string | undefined {
  if (!wixImage) return undefined;
  const match = wixImage.match(/wix:image:\/\/v1\/([^/]+)\/[^#]+/);
  return match ? `https://static.wixstatic.com/media/${match[1]}` : undefined;
}

function chunkItems<T>(items: T[], size: number): T[][] {
  const chunks: T[][] = [];
  for (let i = 0; i < items.length; i += size) {
    chunks.push(items.slice(i, i + size));
  }
  return chunks.length ? chunks : [[]];
}

const orgChunks = chunkItems(organizations, ITEMS_PER_PAGE);
const donorChunks = chunkItems(donors, ITEMS_PER_PAGE);

const orgsTotalPages = Math.max(1, orgChunks.length);
const donorsTotalPages = Math.max(1, donorChunks.length);
---

<Base
  pageMetadata={{
    title: "Partners",
    description:
      "PRISM prides itself in being a collaborative member of the LGBT community in South Florida. See some of our partners below!",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Partners"
    description="PRISM prides itself in being a collaborative member of the LGBT community in South Florida. See some of our partners below! These organizations, businesses, and individuals have shown their steadfast commitment to our motto: 'For Every Color, For Everyone' through partnered events, fundraising initiatives, grants, sponsorships, and other collaborations."
    image={{
      src: "https://picsum.photos/500/300",
      width: 500,
      height: 300,
      alt: "placeholder",
    }}
    pointBackTo={{ href: "/about", label: "About" }}
  />

  <SectionBorder type="marker" backgroundColor="rainbow-purple" />
  <main>
    <section id="organizations" class="partner-section ruled-bg">
      <div class="container">
        <h2>Organizations</h2>

        <Paginator size="lg" totalPages={orgsTotalPages}>
          {
            orgChunks.map((pagePartners) => (
              <div>
                {pagePartners.length > 0 ? (
                  <ul class="grid">
                    {pagePartners.map((partner) => {
                      const logoUrl = wixImageUrl(partner.logo);
                      return (
                        <li>
                          <a
                            href={partner.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="post-it"
                          >
                            {logoUrl ? (
                              <div class="logo">
                                <img
                                  src={logoUrl}
                                  alt={`${partner.title} logo`}
                                />
                              </div>
                            ) : (
                              <div class="logo placeholder">
                                <span>{partner.title[0]}</span>
                              </div>
                            )}
                            <h3>
                              <p>{partner.title}</p>
                            </h3>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="empty">No organization partners to display.</p>
                )}
              </div>
            ))
          }
        </Paginator>
      </div>
      <ScribbleSeparator />
    </section>
    <section id="donors" class="partner-section ruled-bg">
      <div class="container">
        <h2>Donors</h2>

        <Paginator size="lg" totalPages={donorsTotalPages}>
          {
            donorChunks.map((pagePartners) => (
              <div>
                {pagePartners.length > 0 ? (
                  <ul class="grid">
                    {pagePartners.map((partner) => {
                      const logoUrl = wixImageUrl(partner.logo);
                      return (
                        <li>
                          <a
                            href={partner.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="post-it"
                          >
                            {logoUrl ? (
                              <div class="logo">
                                <img
                                  src={logoUrl}
                                  alt={`${partner.title} logo`}
                                />
                              </div>
                            ) : (
                              <div class="logo placeholder">
                                <span>{partner.title[0]}</span>
                              </div>
                            )}
                            <h3>
                              <p>{partner.title}</p>
                            </h3>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="empty">No donors to display.</p>
                )}
              </div>
            ))
          }
        </Paginator>
      </div>
    </section>
    <section class="final-cta">
      <TornPaperBox class="section-content">
        <h2>Ready to Make a Difference?</h2>
        <p>
          Support PRISM and help us create a more inclusive South Florida for
          LGBTQ+ youth!
        </p>
        <a href="/donate" class="cta-button primary">Donate</a>
      </TornPaperBox>
    </section>
  </main>
</Base>

<style lang="scss">
  .page-content {
    background-color: var(--rainbow-purple);
    * {
      /* transition: all 300ms; */
    }
  }

  main {
    margin: auto;
    font-size: 1.25rem;
  }

  #organizations,
  #donors {
    background-size: 2000px;
    background-repeat: repeat-y;
    background-position: top center;
  }

  .container {
    margin: auto;
    padding: 4rem 0rem;
  }

  h2 {
    font-size: 4rem;
    font-family: var(--handwriting);
    position: relative;
    text-align: center;
    margin-bottom: 2rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0 15vw;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;

    li .post-it {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      height: 100%;
      /* transition: transform 0.2s ease; */
      filter: var(--shadow-light);

      &:hover {
        transform: translateY(-4px);
        filter: var(--shadow);
        cursor: pointer;
      }

      .logo {
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--cursive);

        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }

        &.placeholder {
          background-color: var(--rainbow-purple);
          color: white;
          font-size: 2rem;
          font-family: var(--handwriting);
          font-weight: bold;
        }
      }

      h3 {
        font-size: 1.25rem;
        text-align: center;
        margin: 0;

        a {
          color: var(--text-color);
          text-decoration: none;
          font-family: var(--cursive);
        }
      }
    }
  }

  .final-cta {
    padding: 4rem 2rem;
    background: linear-gradient(
      135deg,
      var(--rainbow-red),
      var(--rainbow-orange),
      var(--rainbow-yellow),
      var(--rainbow-green),
      var(--rainbow-blue),
      var(--rainbow-purple)
    );
    text-align: center;

    .section-content {
      max-width: 800px;
      margin: 0 auto;

      h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }

      p {
        font-size: 1.2rem;
        margin-bottom: 2rem;
      }

      .cta-button {
        &:hover {
          background: var(--fg-color);
          color: var(--youth-yellow-2);
        }
      }
    }
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    /* border-radius: 8px; */
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;

    &.primary {
      background: var(--rainbow-green);
      color: white;

      &:hover {
        opacity: 0.9;
        transform: translateY(-2px);
      }
    }

    &.secondary {
      background: var(--fg-color);
      color: var(--text-color);
      border: 2px solid var(--rainbow-green);

      &:hover {
        background: var(--rainbow-green);
        color: white;
      }
    }
  }

  .empty {
    text-align: center;
    font-size: 1.25rem;
  }
</style>
