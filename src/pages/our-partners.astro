---
import arrow from "@assets/img/pagination-arrow.png";
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import { getItems } from "@api/wix";
import ruledPaper from "@assets/img/ruled-bg.png";
import ScribbleSeparator from "@components/ScribbleSeparator.astro";
import { Image } from "astro:assets";

interface Partner {
  _id: string;
  _owner: string;
  _createdDate: string;
  _updatedDate: string;
  title: string;
  gala: boolean;
  website?: string;
  logo?: string;
  sponsorship?: string[];
}

const ITEMS_PER_PAGE = 12;

const allPartners: Partner[] = await getItems("Partners");

const organizations = allPartners.filter((p) => p.organization);
const donors = allPartners.filter((p) => p.donor);

const orgsTotalPages = Math.max(
  1,
  Math.ceil(organizations.length / ITEMS_PER_PAGE),
);
const donorsTotalPages = Math.max(1, Math.ceil(donors.length / ITEMS_PER_PAGE));

function wixImageUrl(wixImage: string | undefined): string | undefined {
  if (!wixImage) return undefined;
  const match = wixImage.match(/wix:image:\/\/v1\/([^/]+)\/[^#]+/);
  return match ? `https://static.wixstatic.com/media/${match[1]}` : undefined;
}

function chunkItems<T>(items: T[], size: number): T[][] {
  const chunks: T[][] = [];
  for (let i = 0; i < items.length; i += size) {
    chunks.push(items.slice(i, i + size));
  }
  return chunks.length ? chunks : [[]];
}

const orgChunks = chunkItems(organizations, ITEMS_PER_PAGE);
const donorChunks = chunkItems(donors, ITEMS_PER_PAGE);
---

<Base
  pageMetadata={{
    title: "Partners",
    description:
      "PRISM prides itself in being a collaborative member of the LGBT community in South Florida. See some of our partners below!",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Partners"
    description="PRISM prides itself in being a collaborative member of the LGBT community in South Florida. See some of our partners below! These organizations, businesses, and individuals have shown their steadfast commitment to our motto: 'For Every Color, For Everyone' through partnered events, fundraising initiatives, grants, sponsorships, and other collaborations."
    image={{
      src: "https://picsum.photos/500/300",
      width: 500,
      height: 300,
      alt: "placeholder",
    }}
    pointBackTo={{ href: "/about", label: "About" }}
  />

  <SectionBorder type="marker" backgroundColor="rainbow-purple" />
  <main>
    <section
      id="organizations"
      class="partner-section"
      data-total-pages={orgsTotalPages}
      style={`background-image: url(${ruledPaper.src});`}
    >
      <div class="container">
        <h2>Organizations</h2>

        <div class="slider" data-section="organizations">
          <div class="track">
            {
              orgChunks.map((pagePartners, pageIndex) => (
                <div class="page" data-page={pageIndex + 1}>
                  {pagePartners.length > 0 ? (
                    <ul class="grid">
                      {pagePartners.map((partner) => {
                        const logoUrl = wixImageUrl(partner.logo);

                        return (
                          <li>
                            <article>
                              {logoUrl ? (
                                <div class="logo">
                                  <img
                                    src={logoUrl}
                                    alt={`${partner.title} logo`}
                                  />
                                </div>
                              ) : (
                                <div class="logo placeholder">
                                  <span>{partner.title[0]}</span>
                                </div>
                              )}
                              <h3>
                                {partner.website ? (
                                  <a
                                    href={partner.website}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                  >
                                    {partner.title}
                                  </a>
                                ) : (
                                  partner.title
                                )}
                              </h3>
                            </article>
                          </li>
                        );
                      })}
                    </ul>
                  ) : (
                    <p class="empty">No organization partners to display.</p>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        {
          orgsTotalPages > 1 && (
            <nav
              class="pagination"
              data-section="organizations"
              aria-label="Organizations pagination"
            >
              <button class="prev" data-page="-1" disabled>
                <Image src={arrow} alt="Previous Page" />
              </button>
              <span class="status">
                Page <span class="current">1</span> of {orgsTotalPages}
              </span>
              <button
                class="next"
                data-page="+1"
                disabled={orgsTotalPages <= 1}
              >
                <Image src={arrow} class="flip" alt="Previous Page" />
              </button>
            </nav>
          )
        }
      </div>
      <ScribbleSeparator />
    </section>

    <section
      id="donors"
      class="partner-section"
      data-total-pages={donorsTotalPages}
      style={`background-image: url(${ruledPaper.src});`}
    >
      <div class="container">
        <h2>Donors</h2>

        <div class="slider" data-section="donors">
          <div class="track">
            {
              donorChunks.map((pagePartners, pageIndex) => (
                <div class="page" data-page={pageIndex + 1}>
                  {pagePartners.length > 0 ? (
                    <ul class="grid">
                      {pagePartners.map((partner) => {
                        const logoUrl = wixImageUrl(partner.logo);

                        return (
                          <li>
                            <article>
                              {logoUrl ? (
                                <div class="logo">
                                  <img
                                    src={logoUrl}
                                    alt={`${partner.title} logo`}
                                  />
                                </div>
                              ) : (
                                <div class="logo placeholder">
                                  <span>{partner.title[0]}</span>
                                </div>
                              )}
                              <h3>
                                {partner.website ? (
                                  <a
                                    href={partner.website}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                  >
                                    {partner.title}
                                  </a>
                                ) : (
                                  partner.title
                                )}
                              </h3>
                            </article>
                          </li>
                        );
                      })}
                    </ul>
                  ) : (
                    <p class="empty">No donors to display.</p>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        {
          donorsTotalPages > 1 && (
            <nav
              class="pagination"
              data-section="donors"
              aria-label="Donors pagination"
            >
              <button class="prev" data-page="-1" disabled>
                <Image src={arrow} alt="Previous Page" />
              </button>
              <span class="status">
                Page <span class="current">1</span> of {donorsTotalPages}
              </span>
              <button
                class="next"
                data-page="+1"
                disabled={donorsTotalPages <= 1}
              >
                <Image src={arrow} class="flip" alt="Next Page" />
              </button>
            </nav>
          )
        }
      </div>
    </section>
  </main>
</Base>

<script>
  function initSlider(section: string) {
    const slider = document.querySelector(
      `.slider[data-section="${section}"]`,
    ) as HTMLElement;
    const track = slider?.querySelector(".track") as HTMLElement;
    const pagination = document.querySelector(
      `.pagination[data-section="${section}"]`,
    ) as HTMLElement;
    if (!slider || !track || !pagination) return;

    const totalPages = parseInt(
      slider.closest(".partner-section")?.getAttribute("data-total-pages") ||
        "1",
      10,
    );
    let currentPage = 1;

    const prevButton = pagination.querySelector(".prev") as HTMLButtonElement;
    const nextButton = pagination.querySelector(".next") as HTMLButtonElement;
    const currentLabel = pagination.querySelector(".current") as HTMLElement;

    function updateButtons() {
      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= totalPages;
      currentLabel.textContent = currentPage.toString();
    }

    function goToPage(newPage: number) {
      if (newPage < 1 || newPage > totalPages || newPage === currentPage)
        return;

      const direction = newPage > currentPage ? "left" : "right";

      track.style.setProperty("--slide-direction", direction);
      track.style.setProperty("--current-page", newPage.toString());

      currentPage = newPage;
      updateButtons();
    }

    prevButton.addEventListener("click", () => goToPage(currentPage - 1));
    nextButton.addEventListener("click", () => goToPage(currentPage + 1));
  }

  initSlider("organizations");
  initSlider("donors");
</script>

<style lang="scss">
  .page-content {
    background-color: var(--rainbow-purple);
    * {
      transition: all 300ms;
    }
  }

  main {
    margin: auto;
    font-size: 1.25rem;
  }

  #organizations,
  #donors {
    background-size: 2000px;
    background-repeat: repeat-y;
    background-position: top center;
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 4rem 1rem;
  }

  h2 {
    font-size: 2rem;
    text-align: center;
    /* color: var(--fg-color); */
    margin-bottom: 2rem;
  }

  .slider {
    overflow: hidden;
    width: 100%;
  }

  .track {
    display: flex;
    width: 100%;
    transition: transform 0.4s ease-in-out;
    transform: translateX(calc((var(--current-page, 1) - 1) * -100%));

    &.animating-left {
      transform: translateX(calc(var(--current-page, 1) * -100%));
    }

    &.animating-right {
      transform: translateX(calc((var(--current-page, 1) - 2) * -100%));
    }
  }

  .page {
    flex: 0 0 100%;
    width: 100%;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;

    li {
      article {
        background: linear-gradient(
          var(--youth-yellow-2),
          var(--youth-yellow-1) 45%
        );
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        height: 100%;
        transition: transform 0.2s ease;

        filter: drop-shadow(1px 1px 1px rgba(0, 0, 0, 0.35));
        &:hover {
          transform: translateY(-4px);
          filter: drop-shadow(1px 1px 1px rgba(0, 0, 0, 0.35));
          cursor: pointer;
        }

        .logo {
          width: 120px;
          height: 120px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-family: var(--handwriting);

          img {
            width: 100%;
            height: 100%;
            object-fit: contain;
          }

          &.placeholder {
            background-color: var(--rainbow-purple);
            border-radius: 50%;
            color: white;
            font-size: 2rem;
            font-family: var(--handwriting);
            font-weight: bold;
          }
        }

        h3 {
          font-size: 1.25rem;
          text-align: center;
          margin: 0;

          a {
            color: var(--text-color);
            text-decoration: none;

            font-family: var(--handwriting);
            /* &:hover { */
            /*   text-decoration: underline; */
            /* } */
          }
        }
      }
    }
  }

  .empty {
    text-align: center;
    font-size: 1.25rem;
  }

  .pagination {
    max-width: var(--xl);
    margin: 2rem auto 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-size: 1.25rem;

    button {
      background: transparent;
      border: none;
      color: var(--text-color);
      text-decoration: underline;
      font-size: inherit;
      cursor: pointer;

      &:disabled {
        pointer-events: none;
        opacity: 0.5;
        text-decoration: none;
        cursor: default;
      }
    }
  }

  img.flip {
    transform: rotate(180deg);
  }
</style>
