---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import { getItems } from "@api/wix";
import ScribbleSeparator from "@components/ScribbleSeparator.astro";
import Paginator from "@components/Paginator.astro";

interface Partner {
  _id: string;
  _owner: string;
  _createdDate: string;
  _updatedDate: string;
  title: string;
  gala: boolean;
  website?: string;
  logo?: string;
  sponsorship?: string[];
  organization: boolean;
  donor: boolean;
}

const ITEMS_PER_PAGE = 12;

const allPartners: Partner[] = (await getItems(
  "Partners",
)) as unknown as Partner[];

const organizations = allPartners.filter((p) => p.organization);
const donors = allPartners.filter((p) => p.donor);

function wixImageUrl(wixImage: string | undefined): string | undefined {
  if (!wixImage) return undefined;
  const match = wixImage.match(/wix:image:\/\/v1\/([^/]+)\/[^#]+/);
  return match ? `https://static.wixstatic.com/media/${match[1]}` : undefined;
}

function chunkItems<T>(items: T[], size: number): T[][] {
  const chunks: T[][] = [];
  for (let i = 0; i < items.length; i += size) {
    chunks.push(items.slice(i, i + size));
  }
  return chunks.length ? chunks : [[]];
}

const orgChunks = chunkItems(organizations, ITEMS_PER_PAGE);
const donorChunks = chunkItems(donors, ITEMS_PER_PAGE);

const orgsTotalPages = Math.max(1, orgChunks.length);
const donorsTotalPages = Math.max(1, donorChunks.length);
---

<Base
  pageMetadata={{
    title: "Partners",
    description:
      "PRISM prides itself in being a collaborative member of the LGBT community in South Florida. See some of our partners below!",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Partners"
    description="PRISM prides itself in being a collaborative member of the LGBT community in South Florida. See some of our partners below! These organizations, businesses, and individuals have shown their steadfast commitment to our motto: 'For Every Color, For Everyone' through partnered events, fundraising initiatives, grants, sponsorships, and other collaborations."
    image={{
      src: "https://picsum.photos/500/300",
      width: 500,
      height: 300,
      alt: "placeholder",
    }}
    pointBackTo={{ href: "/about", label: "About" }}
  />

  <SectionBorder type="marker" backgroundColor="rainbow-purple" />
  <main>
    <section id="organizations" class="partner-section ruled-bg">
      <div class="container">
        <h2>Organizations</h2>

        <Paginator size="lg" totalPages={orgsTotalPages}>
          {
            orgChunks.map((pagePartners) => (
              <div>
                {pagePartners.length > 0 ? (
                  <ul class="grid">
                    {pagePartners.map((partner) => {
                      const logoUrl = wixImageUrl(partner.logo);
                      return (
                        <li>
                          <article class="post-it">
                            {logoUrl ? (
                              <div class="logo">
                                <img
                                  src={logoUrl}
                                  alt={`${partner.title} logo`}
                                />
                              </div>
                            ) : (
                              <div class="logo placeholder">
                                <span>{partner.title[0]}</span>
                              </div>
                            )}
                            <h3>
                              {partner.website ? (
                                <a
                                  href={partner.website}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  {partner.title}
                                </a>
                              ) : (
                                partner.title
                              )}
                            </h3>
                          </article>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="empty">No organization partners to display.</p>
                )}
              </div>
            ))
          }
        </Paginator>
      </div>
      <ScribbleSeparator />
    </section>

    <section id="donors" class="partner-section ruled-bg">
      <div class="container">
        <h2>Donors</h2>

        <Paginator size="lg" totalPages={donorsTotalPages}>
          {
            donorChunks.map((pagePartners) => (
              <div>
                {pagePartners.length > 0 ? (
                  <ul class="grid">
                    {pagePartners.map((partner) => {
                      const logoUrl = wixImageUrl(partner.logo);
                      return (
                        <li>
                          <article class="post-it">
                            {logoUrl ? (
                              <div class="logo">
                                <img
                                  src={logoUrl}
                                  alt={`${partner.title} logo`}
                                />
                              </div>
                            ) : (
                              <div class="logo placeholder">
                                <span>{partner.title[0]}</span>
                              </div>
                            )}
                            <h3>
                              {partner.website ? (
                                <a
                                  href={partner.website}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  {partner.title}
                                </a>
                              ) : (
                                partner.title
                              )}
                            </h3>
                          </article>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="empty">No donors to display.</p>
                )}
              </div>
            ))
          }
        </Paginator>
      </div>
    </section>
  </main>
</Base>

<style lang="scss">
  .page-content {
    background-color: var(--rainbow-purple);
    * {
      transition: all 300ms;
    }
  }

  main {
    margin: auto;
    font-size: 1.25rem;
  }

  #organizations,
  #donors {
    background-size: 2000px;
    background-repeat: repeat-y;
    background-position: top center;
  }

  .container {
    margin: auto;
    padding: 4rem 0rem;
  }

  h2 {
    font-size: 2rem;
    position: relative;
    text-align: center;
    margin-bottom: 2rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;

    li article {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      height: 100%;
      transition: transform 0.2s ease;
      filter: var(--shadow-light);

      &:hover {
        transform: translateY(-4px);
        filter: var(--shadow);
        cursor: pointer;
      }

      .logo {
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--cursive);

        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }

        &.placeholder {
          background-color: var(--rainbow-purple);
          border-radius: 50%;
          color: white;
          font-size: 2rem;
          font-family: var(--handwriting);
          font-weight: bold;
        }
      }

      h3 {
        font-size: 1.25rem;
        text-align: center;
        margin: 0;

        a {
          color: var(--text-color);
          text-decoration: none;
          font-family: var(--cursive);
        }
      }
    }
  }

  .empty {
    text-align: center;
    font-size: 1.25rem;
  }
</style>
