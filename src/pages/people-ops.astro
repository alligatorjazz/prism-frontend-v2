---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import Polaroid from "@components/Polaroid.astro";
import handsWithHeart from "@assets/img/hands-with-heart.avif";
import mv from "@assets/img/team/mv.avif";
---

<Base
  pageMetadata={{
    title: "People's Operations Core Track",
    description:
      "The People's Operations Track serves as the backbone of our community, focusing on member retention, engagement, and safety within PRISM.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "People's Operations Core Track",
  }}
  class="page-content"
>
  <PageIntro
    title="People's Operations"
    description="The People's Operations Track serves as the backbone of our community, focusing on member retention, engagement, and safety. We are the architects of our internal culture, ensuring that every volunteer and member feels welcomed, supported, and connected to the broader PRISM mission through intentional communication and robust community management."
    image={handsWithHeart}
    pointBackTo={{ href: "/get-involved/", label: "Get Involved" }}
    class="intro"
  />

  <main>
    <SectionBorder type="marker" backgroundColor="activist-aqua" />

    <section id="activities">
      <div class="container">
        <h3>What We Do</h3>
        <p class="lede">
          People's Operations is the internal half of organizing. We build the
          systems and the relationships that keep PRISM a place people want to
          stay — a political home where every volunteer and member feels cared
          for, not just counted.
        </p>

        <div class="card-grid">
          <article class="card">
            <h4>Membership Growth &amp; Retention</h4>
            <p>
              We manage the member journey from intake to long-term engagement,
              including onboarding, advising, wellness checks, and volunteer and
              member orientations.
            </p>
          </article>

          <article class="card">
            <h4>Community Management</h4>
            <p>
              We moderate the PRISM Discord server and make sure our digital
              spaces stay inclusive, safe, and active.
            </p>
          </article>

          <article class="card">
            <h4>Relational Outreach</h4>
            <p>
              We coordinate phonebanking and direct outreach to keep members
              connected to each other and to the work.
            </p>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="activist-aqua" flip />

    <section id="staff" class="ruled-bg">
      <div class="container">
        <h3>Meet the Organizing Director!</h3>
        <div class="content">
          <article>
            <div class="person">
              <Polaroid
                class="portrait"
                image={{
                  src: mv,
                  alt: "Portrait of MariaVictoria Chacón-Briceño",
                  format: "webp",
                  width: 300,
                  height: 300,
                }}
                label="MV Chacón-Briceño"
              />
            </div>
            <div class="description">
              <h4>Organizing Director</h4>
              <p>
                MariaVictoria is a queer, second-generation Venezuelan
                immigrant, born and raised in Miami, Florida. They earned a
                Bachelor of Arts in Political Science with a Double Minor in
                Public Administration and Anthropology from Florida
                International University. MV has been advocating and organizing
                in her community since 2018 on issues such as gun violence
                prevention, education equity, youth civic engagement, LGBTQ+
                rights, and economic justice. She prides herself on being a
                continuous student to the practice of community organizing and
                is passionate about building relationships and developing the
                skills of her peers. When MV isn't organizing you can find them
                salsa dancing, reading in a hammock, or having philosophical
                conversations with anyone who will listen.
              </p>
              <button type="button">Read More About MV →</button>
            </div>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="activist-aqua" />

    <section id="pathway">
      <div class="container">
        <h3>How to Get Involved</h3>
        <p class="pathway-note">
          This track requires a deeper understanding of PRISM and more
          consistent engagement, so it begins at the Member tier. If you're new,
          start by volunteering — you join People's Operations after a 1:1
          intake with the Organizing Director or a People's Operations Leader,
          where you choose your core track.
        </p>

        <div class="card-grid two-up">
          <article class="card">
            <span class="tier-label member">Member</span>
            <p>
              Engages Discord members, phonebanks (not campaign-related),
              conducts wellness checks, and recruits at mixers.
            </p>
            <p class="trainings">
              <strong>Trainings:</strong> Discord 101, Relational Organizing, Conflict
              De-escalation
            </p>
          </article>

          <article class="card">
            <span class="tier-label leader">Leader</span>
            <p>
              Conducts intake 1:1s with new volunteers, co-facilitates
              Orientations, and/or moderates the Discord server.
            </p>
            <p class="trainings">
              <strong>Trainings:</strong> Advanced Facilitation, Crisis Management
            </p>
          </article>
        </div>

        <div class="leader-roles">
          <h4>Leader Roles in This Track</h4>
          <ul>
            <li>
              <strong>Onboarding Specialist</strong> — co-facilitates Orientations,
              recruits at mixers, and runs intake 1:1s with new volunteers.
            </li>
            <li>
              <strong>Discord Moderator</strong> — starts conversations on our channels,
              keeps them respectful, and de-escalates conflict over text.
            </li>
            <li>
              <strong>Retention Manager</strong> — stays in relationship with volunteers
              and members so they keep feeling taken care of and invested in PRISM.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="activist-aqua" flip />

    <section id="cta" class="ruled-bg">
      <div class="container">
        <h3>Help Build Our Community</h3>
        <p>
          Whether you're welcoming new members through intake calls, keeping our
          Discord a safe and vibrant space, or checking in on volunteers to make
          sure they feel cared for, every act of stewardship strengthens the
          foundation of our movement. Join People's Operations and help make
          PRISM a political home where everyone belongs.
        </p>
        <a href="/volunteer/" class="cta-button">Sign Up to Volunteer</a>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="activist-aqua" />
  </main>

  <style>
    .page-content {
      background-color: var(--activist-aqua);
    }

    main {
      margin: auto;
      font-size: 1.25rem;

      h2 {
        font-size: 2rem;
        text-align: center;
      }

      h3 {
        text-align: center;
        font-size: 1.75rem;
      }

      h4 {
        font-size: 1.5rem;
      }
    }

    .container {
      max-width: var(--xl);
      margin: auto;
      padding: 0 1rem;
    }

    .lede {
      max-width: 700px;
      margin: 1rem auto 0;
      text-align: center;
    }

    /* Shared card treatment for "What We Do" and the tier pathway. */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 2rem;
      max-width: var(--lg);
      margin-left: auto;
      margin-right: auto;
    }

    .card-grid.two-up {
      grid-template-columns: repeat(2, 1fr);
      max-width: 900px;
    }

    .card {
      border: 2px solid var(--fg-color);
      border-radius: var(--round-edge);
      filter: var(--shadow);
      background: var(--activist-aqua);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      color: var(--fg-color);

      h4 {
        margin: 0;
        font-size: 1.25rem;
      }

      p {
        margin: 0;
      }

      .tier-label {
        align-self: flex-start;
        background-color: var(--text-color);
        color: var(--fg-color);
        font-family: var(--header-font);
        font-weight: bold;
        padding: 0.25rem 0.75rem;
        border-radius: var(--round-edge);
        text-transform: uppercase;
        font-size: 0.875rem;

        &.member {
          background-color: var(--activist-aqua);
          color: var(--fg-color);
          border: 1px solid var(--fg-color);
        }

        &.leader {
          background-color: var(--text-color);
          color: var(--fg-color);
        }
      }

      .trainings {
        margin-top: auto;
        font-size: 1rem;
        color: var(--fg-color);
      }
    }

    #activities {
      background-color: var(--activist-aqua);
      padding: 4rem 0;
    }

    #staff {
      padding: 4rem 0;
      background-size: 2100px;

      .content {
        max-width: var(--lg);
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: auto;
        padding: 2rem 0;

        article {
          display: flex;
          gap: 1rem;

          .person {
            display: flex;
            flex-direction: column;

            .portrait {
              width: 220px;
              height: 250px;
              filter: var(--shadow);
            }

            .name {
              white-space: nowrap;
              font-family: var(--header-font);
              text-align: center;
            }
          }

          .description {
            display: flex;
            flex-direction: column;
            gap: 1rem;

            button {
              background: var(--activist-aqua);
              padding: 1rem;
              font-weight: bold;
              font-size: 1.25rem;
            }

            * {
              margin: 0;
            }
          }
        }
      }
    }

    #pathway {
      background-color: var(--activist-aqua);
      padding: 4rem 0;

      .pathway-note {
        text-align: center;
        font-style: italic;
        max-width: 640px;
        margin: 1rem auto 0;
        color: var(--fg-color);
      }

      .leader-roles {
        max-width: 900px;
        margin: 3rem auto 0;

        h4 {
          text-align: center;
          font-size: 1.25rem;
          margin: 0 0 1rem;
          color: var(--fg-color);
        }

        ul {
          list-style: none;
          margin: 0;
          padding: 0;
          display: grid;
          gap: 1rem;
        }

        li {
          background-color: var(--fg-color);
          color: var(--text-color);
          border-radius: var(--round-edge);
          filter: var(--shadow-light);
          padding: 1rem 1.5rem;
          font-size: 1.125rem;
          line-height: 1.5;
        }

        strong {
          font-family: var(--header-font);
        }
      }
    }

    #cta {
      padding: 4rem 0;
      background-size: 2100px;

      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: var(--lg);

        p {
          font-size: 1.5rem;
          text-align: center;
        }
      }

      .cta-button {
        display: block;
        margin-top: 1.5rem;
        background-color: var(--activist-aqua);
        color: var(--fg-color);
        padding: 1rem 2rem;
        border-radius: var(--round-edge);
        font-weight: bold;
        font-size: 1.25rem;
        text-align: center;
        text-decoration: none;
        transition: all 300ms;

        &:hover {
          filter: brightness(110%);
        }
      }
    }
  </style>
</Base>
