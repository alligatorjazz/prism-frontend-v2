---
// src/pages/people-ops.astro
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import TrackIntro from "@sections/TrackIntro.astro";
import handsWithHeart from "@assets/img/hands-with-heart.avif";
import mv from "@assets/img/team/mv.avif";

// Key Activities, from the Membership Model's People's Operations Track.
const activities = [
  {
    title: "Membership Growth & Retention",
    description:
      "We manage the member journey from intake to long-term engagement, including onboarding, advising, wellness checks, and volunteer and member orientations.",
  },
  {
    title: "Community Management",
    description:
      "We moderate the PRISM Discord server and make sure our digital spaces stay inclusive, safe, and active.",
  },
  {
    title: "Relational Outreach",
    description:
      "We coordinate phonebanking and direct outreach to keep members connected to each other and to the work.",
  },
];
---

<Base
  pageMetadata={{
    title: "People's Operations Core Track",
    description:
      "The People's Operations Track serves as the backbone of our community, focusing on member retention, engagement, and safety within PRISM.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "People's Operations Core Track",
  }}
  class="page-content"
>
  <PageIntro
    title="People's Operations"
    description="The People's Operations Track serves as the backbone of our community, focusing on member retention, engagement, and safety. We are the architects of our internal culture, ensuring that every volunteer and member feels welcomed, supported, and connected to the broader PRISM mission through intentional communication and robust community management."
    image={handsWithHeart}
    pointBackTo={{ href: "/get-involved/", label: "Get Involved" }}
    class="intro"
  />

  <main>
    <!-- Who leads the track, alongside what the track does -->
    <SectionBorder type="marker" backgroundColor="activist-aqua" />

    <TrackIntro
      id="about"
      class="ruled-bg"
      heading="What We Do"
      eyebrow="Track Lead"
      name="MV Chacón-Briceño"
      title="Organizing Director"
      image={mv}
      imageAlt="Portrait of MariaVictoria Chacón-Briceño"
      description="People's Operations is the internal half of organizing. We build the systems and the relationships that keep PRISM a place people want to stay — a political home where every volunteer and member feels cared for, not just counted."
      activities={activities}
    />

    <SectionBorder type="marker" backgroundColor="activist-aqua" flip />

    <!-- Based on: Membership Model - People's Operations Pipeline -->
    <section id="pathway">
      <div class="container">
        <h3>How to Get Involved</h3>
        <p class="pathway-note">
          This track requires a deeper understanding of PRISM and more
          consistent engagement, so it begins at the Member tier. If you're new,
          start by volunteering with our <a href="/get-involved"
            >other core tracks!</a
          >
        </p>

        <div class="card-grid">
          <article class="card">
            <span class="tier-label member">Member</span>
            <p>
              Engages Discord members, phonebanks (not campaign-related),
              conducts wellness checks, and recruits at mixers.
            </p>
          </article>

          <article class="card">
            <span class="tier-label leader">Leader</span>
            <p>
              Conducts intake 1:1s with new volunteers, co-facilitates
              Orientations, and/or moderates the Discord server.
            </p>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="activist-aqua" />

    <section id="cta" class="ruled-bg">
      <div class="container">
        <h3>Help Build Our Community</h3>
        <p>
          Whether you're welcoming new members through intake calls, keeping our
          Discord a safe and vibrant space, or checking in on volunteers to make
          sure they feel cared for, every act of stewardship strengthens the
          foundation of our movement. Join People's Operations and help make
          PRISM a political home where everyone belongs.
        </p>
        <a
          href="https://prismfl.app.neoncrm.com/forms/volunteer-interest-form"
          class="cta-button">Sign Up to Volunteer</a
        >
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="activist-aqua" />
  </main>

  <style lang="scss">
    .page-content {
      background-color: var(--activist-aqua);
    }

    main {
      margin: auto;
      font-size: 1.25rem;

      h2 {
        font-size: 2rem;
        text-align: center;
      }

      h3 {
        text-align: center;
        font-size: 1.75rem;
      }

      h4 {
        font-size: 1.5rem;
      }
    }

    .container {
      max-width: var(--xl);
      margin: auto;
      padding: 0 1rem;
    }

    /* The intro's <section> is rendered inside TrackIntro.astro, so the scoped
       rules above cannot reach it. The id is unique to this page, so a global
       selector is the honest fix rather than a leak. */
    :global(#about) {
      background-color: var(--activist-aqua);
      background-size: 2100px;
    }

    #pathway {
      background-color: var(--activist-aqua);
      padding: 8rem 0;

      color: var(--fg-color);
      h3 {
        font-size: 3rem;
      }
      .pathway-note {
        font-size: 1.5rem;
        text-align: center;
        font-style: italic;
        max-width: 640px;
        margin: 1rem auto 0;
        color: var(--fg-color);
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        max-width: 900px;
        margin: 2rem auto 0;
      }

      .card {
        border: 2px solid var(--fg-color);
        /* border-radius: var(--round-edge); */
        filter: var(--shadow);
        background: var(--activist-aqua);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        color: var(--fg-color);

        p {
          margin: 0;
        }

        .tier-label {
          align-self: flex-start;
          background-color: var(--text-color);
          color: var(--fg-color);
          font-family: var(--header-font);
          font-weight: bold;
          padding: 0.25rem 0.75rem;
          border-radius: var(--round-edge);
          text-transform: uppercase;
          font-size: 0.875rem;

          &.member {
            background-color: var(--activist-aqua);
            color: var(--fg-color);
            border: 1px solid var(--fg-color);
          }

          &.leader {
            background-color: var(--text-color);
            color: var(--fg-color);
          }
        }

        .trainings {
          margin-top: auto;
          font-size: 1rem;
          color: var(--fg-color);
        }
      }

      .leader-roles {
        max-width: 900px;
        margin: 3rem auto 0;

        h4 {
          text-align: center;
          font-size: 1.25rem;
          margin: 0 0 1rem;
          color: var(--fg-color);
        }

        ul {
          list-style: none;
          margin: 0;
          padding: 0;
          display: grid;
          gap: 1rem;
        }

        li {
          background-color: var(--fg-color);
          color: var(--text-color);
          border-radius: var(--round-edge);
          filter: var(--shadow-light);
          padding: 1rem 1.5rem;
          font-size: 1.125rem;
          line-height: 1.5;
        }

        strong {
          font-family: var(--header-font);
        }
      }
    }

    #cta {
      padding: 4rem 0;
      background-size: 2100px;

      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: var(--lg);

        p {
          font-size: 1.5rem;
          text-align: center;
        }
      }

      .cta-button {
        display: block;
        margin-top: 1.5rem;
        background-color: var(--activist-aqua);
        color: var(--fg-color);
        padding: 1rem 2rem;
        border-radius: var(--round-edge);
        font-weight: bold;
        font-size: 1.25rem;
        text-align: center;
        text-decoration: none;
        transition: all 300ms;

        &:hover {
          filter: brightness(110%);
        }
      }
    }
  </style>
</Base>
