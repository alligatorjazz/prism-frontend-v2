---
// src/pages/outreach.astro
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import SectionBorder from "@components/SectionBorder.astro";
import TrackIntro from "@sections/TrackIntro.astro";
import Polaroid from "@components/Polaroid.astro";
import ThreeIconCluster from "@components/ThreeIconCluster.astro";
import TornPaperBox from "@components/TornPaperBox.astro";
import { faker } from "@faker-js/faker";
import megaphone from "@assets/img/megaphone.avif";
import avion from "@assets/img/team/avion.avif";

// Key Activities, from the Membership Model's Outreach Track.
const activities = [
  {
    title: "Tabling",
    description:
      "Outreach captures signups and makes high-volume initial pitches at festivals and community events. This is our primary engine for volunteer recruitment and resource distribution.",
  },
  {
    title: "Social Events",
    description:
      "Low-stakes social spaces where People's Ops and Outreach members facilitate intentional 1:1 organizing conversations to deepen relationships and move supporters up the ladder of engagement.",
  },
];
---

<Base
  pageMetadata={{
    title: "Outreach Core Track",
    description:
      "The Outreach Track is the face of PRISM on the ground, responsible for community-facing events, sexual health education, and harm-reduction resource distribution.",
    type: "website",
    image: megaphone.src,
    "image:alt": "Outreach Core Track",
  }}
  class="page-content"
>
  <PageIntro
    title="Outreach"
    description="The Outreach Track is the face of PRISM on the ground, responsible for community-facing events such as pride festivals, social mixers, and career fairs. We get the word out about PRISM's work, educate on sexual health, gender identity, and LGBTQ+ history, and distribute essential harm-reduction resources — including Naloxone, condoms, and lubricants."
    image={megaphone}
    pointBackTo={{ href: "/get-involved/", label: "Get Involved" }}
    class="intro"
  />

  <main>
    <!-- Who leads the track, alongside what the track does -->
    <SectionBorder type="marker" backgroundColor="rainbow-orange" />

    <TrackIntro
      id="about"
      class="ruled-bg"
      heading="What We Do"
      eyebrow="Track Lead"
      name="Avion Goordeen"
      title="Outreach Director"
      image={avion}
      imageAlt="Portrait of Avion Goordeen"
      description="The Outreach Track is led by the Outreach Director, who manages logistics, orders supplies, plans social events, and develops members in the Outreach Track. Outreach is supported by our Organizing Director, who oversees membership and focuses on recruitment, volunteer onboarding, and orienting new members."
      activities={activities}
    />

    <SectionBorder type="marker" backgroundColor="rainbow-orange" flip />

    <!-- Based on: Membership Model - Outreach Pipeline -->
    <section id="pathway">
      <div class="container">
        <h3>How to Get Involved</h3>
        <p class="pathway-note">
          Outreach is the front door of PRISM, so this track welcomes
          Volunteers. Attend a Quarterly Orientation or schedule a 1:1 intake,
          then join our Discord to get connected with the Outreach team.
        </p>

        <div class="card-grid">
          <article class="card">
            <span class="tier-label">Volunteer</span>
            <p>
              Boots on the ground at tabling; distributes resources and flyers.
              Focuses on high-volume initial engagement and registration.
            </p>
          </article>

          <article class="card">
            <span class="tier-label member">Member</span>
            <p>
              Engages in deeper conversations at community events about PRISM's
              work, and supports in designing social events.
            </p>
          </article>

          <article class="card">
            <span class="tier-label leader">Leader</span>
            <p>
              Oversees tabling efforts, co-creates social events, and/or trains
              new volunteers.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Achievements. Left intact, as requested. -->
    <section id="impact">
      <div class="container">
        <div class="impact-wrapper">
          <div class="cluster">
            <ThreeIconCluster class={"icons"}>
              <Polaroid
                slot="top"
                image={{
                  src: faker.image.urlPicsumPhotos({
                    width: 250,
                    height: 250,
                  }),
                  alt: "Creative Fellow",
                  format: "webp",
                  width: 250,
                  height: 250,
                }}
              />
              <Polaroid
                slot="middle"
                image={{
                  src: faker.image.urlPicsumPhotos({
                    width: 250,
                    height: 250,
                  }),
                  alt: "Creative Fellow",
                  format: "webp",
                  width: 250,
                  height: 250,
                }}
              />
              <Polaroid
                slot="bottom"
                image={{
                  src: faker.image.urlPicsumPhotos({
                    width: 250,
                    height: 250,
                  }),
                  alt: "Creative Fellow",
                  format: "webp",
                  width: 250,
                  height: 250,
                }}
              />
            </ThreeIconCluster>
          </div>
          <div class="wins">
            <TornPaperBox
              ><h3>Our Outreach Has Impact</h3>
              <ul>
                <li>
                  <strong>93</strong> unique volunteers mobilized across South Florida
                </li>
                <li>
                  <strong>943.66</strong> service hours accrued by PRISM Outreach
                </li>
                <li>
                  <strong>66</strong> outreach events hosted across the tri-county
                  area
                </li>
              </ul></TornPaperBox
            >
          </div>
        </div>
      </div>
    </section>

    <SectionBorder type="marker" backgroundColor="rainbow-orange" />

    <section id="cta" class="ruled-bg">
      <div class="container">
        <h3>Ready to Make a Difference?</h3>
        <p>
          Whether you're handing out resources at a tabling event, connecting
          with community members at a pride festival, or helping set up for a
          social mixer, every volunteer hour strengthens our movement.
        </p>
        <a
          href="https://prismfl.app.neoncrm.com/forms/volunteer-interest-form"
          class="cta-button">Sign Up to Volunteer</a
        >
      </div>
    </section>
  </main>

  <style lang="scss">
    .page-content {
      background-color: var(--rainbow-orange);
    }

    main {
      margin: auto;
      font-size: 1.25rem;

      h2 {
        font-size: 2rem;
        text-align: center;
      }

      h3 {
        text-align: center;
        font-size: 1.75rem;
      }

      h4 {
        font-size: 1.5rem;
      }
    }

    .container {
      max-width: var(--xl);
      margin: auto;
      padding: 0 1rem;
    }

    /* The intro's <section> is rendered inside TrackIntro.astro, so the scoped
       rules above cannot reach it. The id is unique to this page, so a global
       selector is the honest fix rather than a leak. */
    :global(#about) {
      background-color: var(--rainbow-orange);
      background-size: 2100px;
    }

    #pathway {
      background-color: var(--rainbow-orange);
      padding: 8rem 0;

      color: var(--fg-color);
      h3 {
        font-size: 3rem;
      }
      .pathway-note {
        font-size: 1.5rem;
        text-align: center;
        font-style: italic;
        max-width: 640px;
        margin: 1rem auto 0;
        color: var(--fg-color);
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        max-width: var(--lg);
        margin: 2rem auto 0;
      }

      .card {
        border: 2px solid var(--fg-color);
        filter: var(--shadow);
        background: var(--rainbow-orange);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        color: var(--fg-color);

        p {
          margin: 0;
        }

        .tier-label {
          align-self: flex-start;
          background-color: var(--text-color);
          color: var(--fg-color);
          font-family: var(--header-font);
          font-weight: bold;
          padding: 0.25rem 0.75rem;
          border-radius: var(--round-edge);
          text-transform: uppercase;
          font-size: 0.875rem;

          &.member {
            background-color: var(--rainbow-orange);
            color: var(--fg-color);
            border: 1px solid var(--fg-color);
          }

          &.leader {
            background-color: var(--text-color);
            color: var(--fg-color);
          }
        }

        .trainings {
          margin-top: auto;
          font-size: 1rem;
          color: var(--fg-color);
        }
      }
    }

    /* Achievements block: cluster beside the paper "wins" list. */
    #impact {
      background-color: var(--rainbow-orange);
      padding: 4rem 0;

      .impact-wrapper {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 3rem;
      }

      .cluster,
      .wins {
        flex: 1 1 22rem;
        max-width: 34rem;
      }
    }

    #cta {
      padding: 4rem 0;
      background-size: 2100px;

      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: var(--lg);

        p {
          font-size: 1.5rem;
          text-align: center;
        }
      }

      .cta-button {
        display: block;
        margin-top: 1.5rem;
        background-color: var(--rainbow-orange);
        color: var(--fg-color);
        padding: 1rem 2rem;
        border-radius: var(--round-edge);
        font-weight: bold;
        font-size: 1.25rem;
        text-align: center;
        text-decoration: none;
        transition: all 300ms;

        &:hover {
          filter: brightness(110%);
        }
      }
    }
  </style>
</Base>
