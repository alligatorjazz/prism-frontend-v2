---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import CenteredPaperWithHeader from "@sections/CenteredPaperWithHeader.astro";
import SectionBorder from "@components/SectionBorder.astro";
import Polaroid from "@components/Polaroid.astro";
import { faker } from "@faker-js/faker";

import megaphone from "@assets/img/megaphone.avif";
import Calendar from "@components/Calendar.astro";

const tags = ["Volunteer", "P-SAP", "Creative Fellowship", "Policy"];

function generateEvents(count: number) {
  const events = [];
  const today = new Date();

  for (let i = 0; i < count; i++) {
    const date = faker.date.soon({ days: 90, refDate: today });
    const tag = faker.helpers.arrayElement(tags);

    events.push({
      title: faker.company.catchPhrase(),
      date: date.toISOString(),
      location: faker.location.city(),
      image: null,
      link: faker.internet.url(),
      source: "faker",
      tags: [
        tag,
        faker.helpers.arrayElement(["All Members", "Track Leaders", "Public"]),
      ],
    });
  }

  return events.sort(
    (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
  );
}

const events = generateEvents(24);
---

<Base
  pageMetadata={{
    title: "Outreach Core Track",
    description:
      "The Outreach Core Track coordinates events and other activities to spread awareness of the amazing work PRISM does and builds connections with the community.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Outreach"
    description={faker.lorem.sentences(4)}
    image={megaphone}
    pointBackTo={{ href: "/task-forces", label: "Task Forces" }}
    class={"intro"}
  />

  <main>
    <CenteredPaperWithHeader title="who?">
      <h2 slot="content">Who makes up the Outreach Core Track?</h2>
    </CenteredPaperWithHeader>

    <SectionBorder type="cookie-cutter" backgroundColor="#f19221" />

    <section id="staff">
      <div class="container">
        <h3>Staff</h3>
        <div class="content">
          <article>
            <div class="person">
              <Polaroid
                class="portrait"
                image={{
                  src: faker.image.avatarGitHub(),
                  alt: "Portrait of Avion Goordeen",
                  format: "webp",
                  width: 250,
                  height: 250,
                }}
                label="Avion Goordeen"
              />
            </div>
            <div class="description">
              <h4>Outreach Director</h4>
              <p>{faker.lorem.paragraphs(4)}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="cookie-cutter" backgroundColor="#f19221" flip />

    <section id="pathway">
      <div class="container">
        <h3>Outreach Core Track Pathway</h3>
        <div class="tiers">
          <article>
            <span class="tier-label">Volunteer</span>
            <p>
              Helps set up events, tables at community gatherings, and spreads
              the word about PRISM's work.
            </p>
            <p class="trainings">
              <strong>Trainings:</strong> Outreach 101, Event Setup
            </p>
          </article>

          <article>
            <span class="tier-label member">Member</span>
            <p>
              Represents PRISM at events, coordinates tabling logistics, and
              recruits new volunteers.
            </p>
            <p class="trainings">
              <strong>Trainings:</strong> Public Speaking, Volunteer Recruitment
            </p>
          </article>

          <article>
            <span class="tier-label leader">Leader</span>
            <p>
              Plans outreach strategy, manages event calendars, leads volunteer
              teams, and/or serves as Event Captains.
            </p>
            <p class="trainings">
              <strong>Trainings:</strong> Event Planning, Team Management
            </p>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="cookie-cutter" backgroundColor="#f19221" />

    <section id="calendar">
      <Calendar
        events={events}
        title="Test Calendar"
        backgroundColor={"var(--rainbow-orange)"}
      />
    </section>

    <style>
      .page-content {
        background-color: var(--rainbow-orange);
      }

      main {
        margin: auto;
        font-size: 1.25rem;

        h2 {
          font-size: 2rem;
          text-align: center;
        }

        h3 {
          font-size: 1.75rem;
        }

        h4 {
          font-size: 1.5rem;
        }
      }

      .container {
        max-width: var(--xl);
        margin: auto;
        padding: 0 1rem;
      }

      #staff {
        background-color: white;
        padding: 4rem 0;

        .content {
          display: flex;
          align-items: center;
          gap: 1rem;
          margin: auto;
          padding: 2rem 0;

          article {
            display: flex;
            gap: 1rem;

            .person {
              display: flex;
              flex-direction: column;

              .portrait {
                width: 220px;
                height: 250px;
              }

              .name {
                white-space: nowrap;
                font-family: var(--header-font);
                text-align: center;
              }
            }

            .description {
              display: flex;
              flex-direction: column;
              gap: 1rem;

              * {
                margin: 0;
              }
            }
          }
        }
      }

      #pathway {
        background-color: var(--rainbow-orange);
        padding: 4rem 0;

        .tiers {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 1.5rem;
          margin-top: 2rem;

          article {
            border: 2px solid var(--fg-color);
            border-radius: var(--round-edge);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;

            color: var(--fg-color);

            .tier-label {
              align-self: flex-start;
              background-color: var(--text-color);
              color: var(--fg-color);

              font-family: var(--header-font);
              font-weight: bold;
              padding: 0.25rem 0.75rem;
              border-radius: var(--round-edge);
              text-transform: uppercase;
              font-size: 0.875rem;

              &.member {
                background-color: var(--rainbow-orange);
                color: var(--fg-color);
                border: 1px solid var(--fg-color);
              }

              &.leader {
                background-color: var(--text-color);
                color: var(--fg-color);
              }
            }

            .trainings {
              font-size: 1rem;
              color: var(--fg-color);
              margin-top: auto;
            }
          }
        }
      }

      #calendar {
        background-color: white;
        padding: 4rem 0;

        .events {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 1.5rem;
          margin-top: 2rem;

          article {
            border: 2px solid var(--rainbow-orange);
            border-radius: var(--round-edge);
            padding: 1.5rem;

            h4 {
              margin: 0 0 0.5rem;
            }

            p {
              margin: 0.25rem 0;
            }
          }
        }
      }

      #join {
        background-size: 2000px;
        padding: 4rem 0;

        .content {
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;

          article {
            flex: 1;
            min-width: 45%;
            background-color: var(--fg-color);
            filter: var(--shadow);
            padding: 2rem;
            display: flex;
            flex-direction: column;

            h4 {
              height: 2rem;
            }

            p {
              flex: 1;
            }

            & > a:last-of-type {
              background-color: var(--accent-color);
              padding: 0.5rem 1rem;
              border-radius: var(--round-edge);
              color: var(--fg-color);
              font-weight: bold;
              text-align: center;
              text-decoration: none;
              transition: all 300ms;

              &:hover {
                filter: brightness(110%);
              }
            }
          }
        }
      }
    </style>
  </main></Base
>
