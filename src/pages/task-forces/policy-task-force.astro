---
import Base from "@templates/Base.astro";
import PageIntro from "@sections/PageIntro.astro";
import CenteredPaperWithHeader from "@sections/CenteredPaperWithHeader.astro";
import SectionBorder from "@components/SectionBorder.astro";
import Polaroid from "@components/Polaroid.astro";
import scale from "@assets/img/scale.avif";
import { faker } from "@faker-js/faker";
import ruledBg from "../../assets/img/ruled-bg.png";
import { getImage } from "astro:assets";

const ruledPaper = `url( ${(await getImage({ src: ruledBg, format: "webp" })).src})`;
---

<Base
  pageMetadata={{
    title: "Policy Task Force",
    description:
      "PRISM's Policy Task Force works to advance innovative laws and policies and pushes back against bad bills to ensure that no one suffers discrimination or harassment on the basis of their sexual orientation, race, or gender identity.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
  class={"page-content"}
>
  <PageIntro
    title="Policy Task Force (PTF)"
    description="PRISM's Policy Task Force works to advance innovative laws and policies and pushes back against bad bills to ensure that no one suffers discrimination or harassment on the basis of their sexual orientation, race, or gender identity. The Policy Task Force solves challenges at the local, state, and national levels, with an emphasis on fighting for the LGBTQ+ community, especially LGBTQ+ people of color across South Florida."
    image={scale}
    pointBackTo={{ href: "/task-forces", label: "Task Forces" }}
    class={"intro"}
  />

  <main>
    <CenteredPaperWithHeader title="who?">
      <h2 slot="content">Who makes up the Policy Task Force?</h2>
    </CenteredPaperWithHeader>

    <SectionBorder type="cookie-cutter" backgroundColor="#d02c28" />

    <section id="staff">
      <div class="container">
        <h3>Staff</h3>
        <div class="content">
          <article>
            <div class="person">
              <Polaroid
                class="portrait"
                image={{
                  src: faker.image.avatarGitHub(),
                  alt: "fake",
                  format: "webp",
                  width: 250,
                  height: 250,
                }}
                label="Miles Davis"
              />
            </div>
            <div class="description">
              <h4>Policy Director</h4>
              <p>{faker.lorem.paragraph()}</p>
              <p>{faker.lorem.paragraph()}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <SectionBorder type="cookie-cutter" backgroundColor="#d02c28" flip />

    <section id="join">
      <div class="container">
        <div class="content">
          <article>
            <h4>Interested in helping out?</h4>
            <p>
              We'd love to have you! You can start by filling out a <a
                href="/volunteer-form">Volunteer Application Form</a
              > or contacting us directly.
            </p>
            <a href="/volunteer-form">Click here to apply!</a>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .page-content {
    background-color: var(--rainbow-red);
  }

  main {
    margin: auto;
    font-size: 1.25rem;

    h2 {
      font-size: 2rem;
      text-align: center;
    }

    h3 {
      font-size: 1.75rem;
    }

    h4 {
      font-size: 1.5rem;
    }
  }

  #staff {
    background-color: white;
    padding: 4rem 0;
    .container {
      max-width: var(--xl);
      margin: auto;

      .content {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: auto;
        padding: 2rem 0;

        article {
          display: flex;
          gap: 1rem;
          .person {
            display: flex;
            flex-direction: column;

            .portrait {
              width: 220px;
              height: 250px;
            }

            .name {
              white-space: nowrap;
              font-family: var(--header-font);
              text-align: center;
            }
          }
          .description {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            * {
              margin: 0;
            }
          }
        }
      }
    }
  }

  #join {
    background-size: 2000px;
    padding: 4rem 0;
    .container {
      max-width: var(--xl);
      margin: auto;
      .content {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        article {
          flex: 1;
          min-width: 45%;
          background-color: var(--fg-color);
          filter: var(--shadow);
          padding: 2rem;
          display: flex;
          flex-direction: column;
          h4 {
            height: 2rem;
          }
          p {
            flex: 1;
          }
          & > a:last-of-type {
            background-color: var(--accent-color);
            padding: 0.5rem 1rem;
            border-radius: var(--round-edge);
            color: var(--fg-color);
            font-weight: bold;
            text-align: center;
            text-decoration: none;
            transition: all 300ms;
            &:hover {
              filter: brightness(110%);
            }
          }
        }
      }
    }
  }
</style>
