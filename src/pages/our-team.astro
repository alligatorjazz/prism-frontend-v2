---

<Base
  pageMetadata={{
    title: "Our Team",
    description: "Meet PRISM's staff and board!",
    type: "website",
    image: groupPhoto.src,
    "image:alt": "PRISM staff and board gathered for a group photo",
  }}
>
  <main>
    <!-- ── Cover ───────────────────────────────────────────────── -->
    <section class="cover">
      <span class="spine" aria-hidden="true"></span>
      <div class="cover-inner">
        <Image
          src={prismLogo}
          alt="PRISM"
          class="logo"
          width={220}
          height={220}
        />
        <h1>PRISM Yearbook</h1>
        <p class="year">2026</p>
        <p class="volume">Staff &amp; Board · Volume One · South Florida</p>
      </div>
    </section>

    <!-- <div class="divider"><ScribbleSeparator /></div> -->

    <!-- ── Contents ────────────────────────────────────────────── -->
    <section class="contents" id="contents">
      <div class="container">
        <h2>Contents</h2>
        <ul class="list">
          {
            contents.map(({ href, label, page }) => (
              <li>
                <a href={href}>{label}</a>
                <span class="dots" aria-hidden="true" />
                <!-- <span class="page-number">{page}</span> -->
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Staff ───────────────────────────────────────────────── -->
    <section class="sheet ruled-bg" id="staff">
      <div class="container">
        <h2>Staff Directory</h2>
        <p class="lede">The nine people who run PRISM's day-to-day work.</p>
        <div class="portraits">
          {
            staff.map((member) => (
              <YearbookPortrait
                slug={member.slug}
                name={member.name}
                title={member.title}
                pronouns={member.pronouns}
                photo={member.photo}

              />
            ))
          }
        </div>
      </div>
      <span class="folio" aria-hidden="true">2</span>
    </section>

    <!-- ── Board ───────────────────────────────────────────────── -->
    <section class="sheet ruled-bg" id="board">
      <div class="container">
        <h2>Board of Directors</h2>
        <p class="lede">
          The volunteers who set direction and hold the organization
          accountable.
        </p>
        <div class="portraits">
          {
            board.map((member) => (
              <YearbookPortrait
                slug={member.slug}
                name={member.name}
                title={member.title}
                pronouns={member.pronouns}
                photo={member.photo}
              />
            ))
          }
        </div>
      </div>
      <span class="folio" aria-hidden="true">3</span>
    </section>

    <!-- ── Class photo ─────────────────────────────────────────── -->
    <section class="class-photo" id="class-photo">
      <div class="container">
        <h2>Class Photo</h2>
        <figure>
          <Image
            src={groupPhoto}
            alt="PRISM staff and board gathered together for a group photo"
            class="group"
          />
          <figcaption>PRISM staff &amp; board, 2026.</figcaption>
        </figure>
      </div>
      <span class="folio" aria-hidden="true">4</span>
    </section>
  </main>

  <!-- ── Bios ──────────────────────────────────────────────────── -->
  {
    everyone.map((member) => (
      <Modal id={`member-${member.slug}`}>
        <article class="bio">
          <header>
            {member.photo && (
              <div class="bio-photo">
                <Image
                  src={member.photo}
                  alt={`Portrait of ${member.name}`}
                  width={320}
                  height={400}
                />
              </div>
            )}
            <div class="bio-id">
              <h2>{member.name}</h2>
              <p class="role">{member.title}</p>
              <p class="pronouns">{member.pronouns}</p>
            </div>
          </header>

          <p class="bio-text">{member.bio}</p>

          {member.quote && <blockquote>{member.quote}</blockquote>}

          <button
            class="close"
            type="button"
            data-close-modal={`member-${member.slug}`}
          >
            Close
          </button>
        </article>
      </Modal>
    ))
  }
</Base>

<script>
  /**
   * Opens the bio modal that matches the portrait that was clicked, and closes
   * it again. Modal.astro already listens for `open-modal` / `close-modal` on
   * the document and for backdrop clicks; the two gaps it leaves are that it
   * has no close control of its own and no Escape handling, both filled here.
   */

  const openModal = (id: string) =>
    document.dispatchEvent(new CustomEvent("open-modal", { detail: { id } }));

  const closeModal = (id: string) =>
    document.dispatchEvent(new CustomEvent("close-modal", { detail: { id } }));

  document.querySelectorAll<HTMLElement>("[data-member]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.dataset.member;
      if (id) openModal(`member-${id}`);
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>("[data-close-modal]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.closeModal;
        if (id) closeModal(id);
      });
    });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document
      .querySelectorAll<HTMLElement>(".modal-backdrop[open]")
      .forEach((backdrop) => backdrop.removeAttribute("open"));
  });
</script>

<style lang="scss">
  @use "../styles/utils" as *;

  main {
    background-color: var(--youth-yellow-1);
    font-size: 1.25rem;
  }

  h2 {
    font-size: 2rem;
    text-align: center;
    margin: 0 0 1rem;
  }

  .container {
    max-width: var(--xl);
    margin: auto;
    padding: 4rem 1rem;
  }

  .lede {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  /* ---------- Cover ---------- */

  .cover {
    position: relative;
    padding: 3rem 1.5rem 3rem 3.5rem;
    background:
      radial-gradient(
        circle at 22% 12%,
        rgba(255, 255, 255, 0.14),
        transparent 55%
      ),
      var(--rainbow-purple);
    filter: var(--shadow);
    overflow: hidden;
  }

  /* Faux binding down the left edge. */
  .spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 1.75rem;
    background: rgba(0, 0, 0, 0.18);
    border-right: 2px dashed rgba(255, 255, 255, 0.35);
  }

  .cover-inner {
    max-width: var(--lg);
    margin: auto;
    padding: 3rem 1.5rem;
    border: 4px double var(--youth-yellow-2);
    border-radius: var(--round-edge);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    color: var(--fg-color);

    .logo {
      width: 96px;
      height: auto;
      filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.45));

      @include breakpoint-up(md) {
        width: 120px;
      }
    }

    h1 {
      margin: 0;
      font-size: 2.25rem;
      letter-spacing: 0.02em;
      color: var(--youth-yellow-2);

      @include breakpoint-up(md) {
        font-size: 3.5rem;
      }
    }

    .year {
      margin: 0;
      font-family: var(--header-font);
      font-weight: 700;
      font-size: 4rem;
      line-height: 1;

      @include breakpoint-up(md) {
        font-size: 6rem;
      }
    }

    .volume {
      margin: 0;
      font-family: var(--header-font);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      opacity: 0.85;
    }
  }

  /* ScribbleSeparator ships an unconstrained <Image>, so it is capped here. */
  .divider {
    display: flex;
    justify-content: center;
    padding: 1rem;

    :global(img) {
      max-width: min(100%, 34rem);
      height: auto;
    }
  }

  /* ---------- Contents ---------- */

  .contents {
    background: var(--witty-white);
  }

  .list {
    list-style: none;
    max-width: var(--lg);
    margin: 2rem auto 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;

    li {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
    }

    a {
      font-family: var(--header-font);
      font-weight: 600;
      font-size: 1.25rem;
      color: var(--text-color);

      &:hover {
        text-decoration: underline;
      }
    }

    /* Dot leader, the way a printed contents page runs out to the folio. */
    .dots {
      flex: 1;
      border-bottom: 2px dotted var(--text-color);
      opacity: 0.45;
      transform: translateY(-0.3rem);
    }

  }

  /* ---------- Interior pages ---------- */

  .sheet {
    position: relative;
    background-size: 2000px;
    background-repeat: repeat-y;
    background-position: top center;
  }

  .folio {
    position: absolute;
    right: 2rem;
    bottom: 1.25rem;
    font-family: var(--header-font);
    font-size: 1rem;
    font-weight: 600;
    opacity: 0.55;
  }

  .portraits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 2.5rem 1.75rem;
    max-width: var(--xl);
    margin: 2.5rem auto 0;
  }

  /* ---------- Class photo ---------- */

  .class-photo {
    position: relative;
    background: var(--witty-white);

    figure {
      margin: 2rem auto 0;
      max-width: var(--lg);
      padding: 1rem;
      background: var(--fg-color);
      filter: drop-shadow(2px 3px 3px rgba(0, 0, 0, 0.35));
      rotate: -0.5deg;
    }

    .group {
      display: block;
      width: 100%;
      height: auto;
    }

    figcaption {
      margin-top: 0.75rem;
      text-align: center;
      font-family: var(--handwriting);
      font-size: 1.5rem;
      line-height: 1.1;
    }
  }

  

  .prompt {
    max-width: 34rem;
    margin: 0 auto;
    text-align: center;
    font-family: var(--handwriting);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .signature-lines {
    width: min(100%, var(--lg));
    height: 15rem;
    margin: 2.5rem 0;
    opacity: 0.35;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(2.5rem - 2px),
      var(--text-color) calc(2.5rem - 2px),
      var(--text-color) 2.5rem
    );
  }

  .sign-cta {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: var(--rainbow-purple);
    color: var(--fg-color);
    font-family: var(--header-font);
    font-size: 1.25rem;
    font-weight: 700;
    border-radius: var(--round-edge);
    transition: filter 200ms ease;

    &:hover {
      filter: brightness(110%);
    }
  }

  /* ---------- Bio modal ---------- */

  .bio {
    width: min(90vw, 44rem);
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    background: var(--fg-color);
    border-radius: var(--round-edge);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    header {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .bio-photo {
      flex: 0 0 auto;
      width: 150px;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border: 6px solid var(--witty-white);
      filter: drop-shadow(2px 2px 2px rgba(0, 0, 0, 0.35));

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .bio-id {
      flex: 1;
      min-width: 12rem;
    }

    h2 {
      margin: 0 0 0.25rem;
      font-size: 2rem;
      text-align: left;
    }

    .role {
      margin: 0;
      font-family: var(--header-font);
      font-weight: 600;
    }

    .pronouns {
      margin: 0;
      font-style: italic;
      opacity: 0.65;
    }

    .bio-text {
      margin: 0;
      line-height: 1.6;
    }

    blockquote {
      margin: 0;
      padding: 1rem 1.25rem;
      background: var(--youth-yellow-1);
      border-left: 4px solid var(--youth-yellow-2);
      font-style: italic;
    }

    .close {
      align-self: flex-end;
      padding: 0.75rem 1.5rem;
      background-color: var(--rainbow-purple);
      color: var(--fg-color);
      font-family: var(--header-font);
      font-weight: 700;
      font-size: 1rem;
      border-radius: var(--round-edge);

      &:hover {
        filter: brightness(110%);
      }
    }
  }
</style>
