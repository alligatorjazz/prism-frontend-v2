---
import { faker } from "@faker-js/faker";
import Base from "../templates/Base.astro";
import { toTitleCase } from "../lib/dom";
import { repeatRandom } from "../lib";
import { Image } from "astro:assets";

const fakeTeamMember = () => {
  return {
    title: toTitleCase(faker.lorem.words(2)),
    name: toTitleCase(faker.person.fullName()),
    pronouns: ["he/him", "she/her", "they/them"][Math.floor(Math.random() * 3)],
    description: faker.lorem.sentences(2),
    email: faker.internet.email(),
    image: faker.image.avatarGitHub(),
    contactFor: faker.lorem.words({ min: 3, max: 9 }),
  };
};

const fakeBoardMember = () => {
  return {
    title: toTitleCase(faker.lorem.words(2)),
    name: toTitleCase(faker.person.fullName()),
    pronouns: ["he/him", "she/her", "they/them"][Math.floor(Math.random() * 3)],
    description: faker.lorem.sentences(2),
    image: faker.image.avatarGitHub(),
    email: faker.internet.email(),
  };
};

const team = repeatRandom(fakeTeamMember, 6, 8);
const board = repeatRandom(fakeBoardMember, 5, 8);
---

<Base
  pageMetadata={{
    title: "Our Team",
    description: "Meet PRISM's team and board.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
>
  <main>
    <div class="yearbook">
      <div class="content">
        <h1>PRISM Staff of 2026</h1>
        <div class="staff members">
          <ul class="names">
            {
              team.map((member) => (
                <li data-member={member.name} role="button">
                  {member.name}
                </li>
              ))
            }
          </ul>
          <ul class="photos">
            {
              team.map((member) => (
                <li role="button" data-member={member.name}>
                  <div class="image cover">
                    <Image
                      src={member.image}
                      alt={"dummy"}
                      format="webp"
                      width={500}
                      height={500}
                    />
                  </div>
                  <div class="title">
                    <p>{member.title}</p>
                    <p>{member.pronouns}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <h2>Our Board</h2>
        <div class="board members">
          <ul class="names">
            {
              board.map((member) => (
                <li data-member={member.name} role="button">
                  {member.name}
                </li>
              ))
            }
          </ul>
          <ul class="photos">
            {
              board.map((member) => (
                <li role="button" data-member={member.name}>
                  <div class="image cover">
                    <Image
                      src={member.image}
                      alt={"dummy"}
                      format="webp"
                      width={500}
                      height={500}
                    />
                  </div>
                  <div class="title">
                    <p>{member.title}</p>
                    <p>{member.pronouns}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll<HTMLLIElement>("li[data-member]");

    const activate = (memberId: string) => {
      items.forEach((item) => {
        if (item.dataset.member === memberId) {
          item.classList.add("active");
        }
      });
    };

    const deactivate = (memberId: string) => {
      items.forEach((item) => {
        if (item.dataset.member === memberId) {
          item.classList.remove("active");
        }
      });
    };

    items.forEach((item) => {
      item.addEventListener("mouseenter", () => {
        const memberId = item.dataset.member;
        if (memberId) activate(memberId);
      });

      item.addEventListener("mouseleave", () => {
        const memberId = item.dataset.member;
        if (memberId) deactivate(memberId);
      });
    });
  });
</script>

<style lang="scss">
  @use "../styles/utils.scss" as *;
  main {
    padding: 4rem;
  }

  li[role="button"] {
    transition: all 300ms;
    cursor: pointer;
  }

  .yearbook {
    background: var(--rainbow-blue);
    padding: 2rem;
    filter: var(--shadow);
    h1 {
      font-size: 4rem;
    }
    h2 {
      font-size: 3rem;
      text-align: right;
    }
    .content {
      padding: 2rem;
      background: var(--fg-color);
      filter: var(--shadow-light);

      .members {
        display: flex;
        justify-content: space-between;
        gap: 1;
        align-items: center;
        margin-bottom: 2rem;
        ul.names {
          list-style: none;
          margin: 0;
          display: flex;
          gap: 0.25rem;
          justify-content: space-evenly;
          flex-direction: column;
          font-size: 1.25rem;
          li.active {
            font-weight: bold;
          }
        }

        ul.photos {
          list-style: none;
          margin: 0;
          display: flex;
          justify-content: space-evenly;
          flex-wrap: wrap;
          gap: 1rem;
          width: 100%;
          li {
            text-align: center;
            font-size: 1rem;
            width: 150px;
            min-width: 150px;
            position: relative;
            div.image {
              height: 200px;
            }

            h2 {
              font-size: 1rem;
            }
            h2,
            h3 {
              margin: 0;
            }

            div.title {
              width: 100%;
              height: 100%;
              position: absolute;
              top: 0;
              left: 0;
              display: flex;
              align-items: center;
              flex-direction: column;
              justify-content: center;
              backdrop-filter: blur(5px);
              opacity: 0;
              p {
                margin: 0;
              }
            }

            &.active {
              div.title {
                opacity: 1;
              }
            }
          }
        }
      }
    }
  }

  .board {
    flex-direction: row-reverse;
  }
</style>
