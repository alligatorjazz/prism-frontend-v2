---

<Base
  pageMetadata={{
    title: "Our Team",
    description: "Meet PRISM's team and board.",
    type: "website",
    image: "https://picsum.photos/200",
    "image:alt": "test",
  }}
>
  <main>
    <div class="yearbook">
      <div class="content">
        <h1>PRISM Staff of 2026</h1>
        <div class="staff members">
          <ul class="names">
            {
              team.map((member) => (
                <li data-member={member.name} role="button">
                  {member.name}
                </li>
              ))
            }
          </ul>
          <ul class="photos">
            {
              team.map((member) => (
                <li role="button" data-member={member.name}>
                  <div class="image cover">
                    <img
                      src={member.headshot}
                      alt={member.name}
                      width={500}
                      height={500}
                    />
                  </div>
                  <div class="title">
                    <p>{member.title}</p>
                    <p>{member.pronouns}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <h2>Our Board</h2>
        <div class="board members">
          <ul class="names">
            {
              board.map((member) => (
                <li data-member={member.name} role="button">
                  {member.name}
                </li>
              ))
            }
          </ul>
          <ul class="photos">
            {
              board.map((member) => (
                <li role="button" data-member={member.name}>
                  <div class="image cover">
                    <img
                      src={member.headshot}
                      alt={member.name}
                      width={500}
                      height={500}
                    />
                  </div>
                  <div class="title">
                    <p>{member.title}</p>
                    <p>{member.pronouns}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </main>

  {
    [...team, ...board].map((member) => (
      <Modal id={member.name}>
        <article class="member-bio">
          <header class="bio-header">
            <div class="bio-images">
              <div class="headshot-wrapper">
                <img
                  src={member.headshot}
                  alt={`${member.name} headshot`}
                  width={300}
                  height={300}
                />
              </div>
              <div class="secondary-images">
                <div class="image-wrapper">
                  <img
                    src={member.personality}
                    alt={`${member.name} personality`}
                    width={200}
                    height={200}
                  />
                </div>
                <div class="image-wrapper">
                  <img
                    src={member.field}
                    alt={`${member.name} in the field`}
                    width={200}
                    height={200}
                  />
                </div>
              </div>
            </div>
            <div class="bio-info">
              <h1>{member.name}</h1>
              <p class="title">{member.title}</p>
              <p class="pronouns">{member.pronouns}</p>
            </div>
          </header>
          <section class="bio-content">
            <h2>About {member.name.split(" ")[0]}</h2>
            <p>{member.bio}</p>
          </section>
        </article>
      </Modal>
    ))
  }
</Base>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll<HTMLLIElement>("li[data-member]");

    const activate = (memberId: string) => {
      items.forEach((item) => {
        if (item.dataset.member === memberId) {
          item.classList.add("active");
        }
      });
    };

    const deactivate = (memberId: string) => {
      items.forEach((item) => {
        if (item.dataset.member === memberId) {
          item.classList.remove("active");
        }
      });
    };

    items.forEach((item) => {
      item.addEventListener("mouseenter", () => {
        const memberId = item.dataset.member;
        if (memberId) activate(memberId);
      });

      item.addEventListener("mouseleave", () => {
        const memberId = item.dataset.member;
        if (memberId) deactivate(memberId);
      });

      item.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("open-modal", {
            detail: { id: item.dataset.member },
          }),
        );
      });
    });
  });
</script>

<style lang="scss">
  @use "../styles/utils.scss" as *;
  main {
    padding: 4rem;
  }

  main * {
    transition: all 300ms;
    cursor: pointer;
  }

  .yearbook {
    background: var(--rainbow-blue);
    padding: 2rem;
    filter: var(--shadow);
    h1 {
      font-size: 4rem;
    }
    h2 {
      font-size: 3rem;
      text-align: right;
    }
    .content {
      padding: 2rem;
      background: var(--fg-color);
      filter: var(--shadow-light);

