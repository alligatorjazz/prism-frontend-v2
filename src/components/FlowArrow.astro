---
import arrow1 from "@assets/img/arrow1.png";
import arrow2 from "@assets/img/arrow2.png";
import arrow3 from "@assets/img/arrow3.png";
import arrow4 from "@assets/img/arrow4.png";
import arrow5 from "@assets/img/arrow5.png";

import { Image } from "astro:assets";
// src/components/FlowArrow.astro

type Props = {
  /** Rotation while the layout is side by side. 0deg points right. */
  arrowType?: 1 | 2 | 3 | 4 | 5;
  angleWide?: string;
  flip?: boolean;
  /** Rotation once the container is narrower than the breakpoint. */
  angleStacked?: string;
  size?: string;
  /** Forwarded from the call site so callers can position the arrow. */
  class?: string;
};

const {
  angleWide = "0deg",
  angleStacked = "90deg",
  size = "8rem",
  arrowType = 4,
  flip = false,
  class: className,
} = Astro.props as Props;
---

<div
  class:list={["flow-arrow", flip ? "flip" : "", className]}
  style={`--arrow-angle-wide: ${angleWide}; --arrow-angle-stacked: ${angleStacked}; --arrow-size: ${size};`}
>
  <Image
    src={[arrow1, arrow2, arrow3, arrow4, arrow5][arrowType - 1]}
    alt=""
    format="webp"
    inferSize
  />
</div>

<style lang="scss">
  @use "../styles/utils" as *;
  .flow-arrow {
    --arrow-angle: var(--arrow-angle-stacked, 90deg);
    @include breakpoint-up(md) {
      --arrow-angle: var(--arrow-angle-wide, 0deg);
    }
    width: var(--arrow-size);
    height: var(--arrow-size);

    img {
      width: 100%;
      height: 100%;
      rotate: var(--arrow-angle);
      object-fit: contain;
    }

    &.flip {
      transform: scaleX(-1);
    }
  }
</style>
