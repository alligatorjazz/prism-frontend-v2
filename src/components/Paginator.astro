---
import { Image } from "astro:assets";
import arrow from "@assets/img/pagination-arrow.png";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  totalPages: number;
  startingPage?: number;
  size: "sm" | "md" | "lg";
}

const paginatorId = crypto.randomUUID();

const { totalPages, startingPage, size = "lg", ...props } = Astro.props;
---

<section {...props}>
  <div class="page-slot" data-paginator={`${paginatorId}-page-slot`}>
    <slot />
  </div>
  <nav class:list={["controls", size]}>
    <button
      data-paginator={`${paginatorId}-previous`}
      class="prev arrow-button"
      data-page="-1"
    >
      <Image src={arrow} alt="Previous Page" />
    </button>

    <span class="status">
      <span
        data-paginator={`${paginatorId}-currentPage`}
        data-page={1}
        class="current">{startingPage ?? 1}</span
      > /{" "}
      <span class="total">{totalPages ?? 1}</span>
    </span>
    <button
      data-paginator={`${paginatorId}-next`}
      class="next arrow-button"
      data-page="+1"
    >
      <Image src={arrow} class="flip" alt="Previous Page" />
    </button>
  </nav>
</section>

<style define:vars={{ totalPages }}>
  section {
    overflow: hidden;
  }

  nav.controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: auto;

    .status {
      display: flex;
      font-family: var(--handwriting);
      align-items: center;
      gap: 1rem;
    }

    button.next {
      transform: scaleX(-1);
    }
  }

  .page-slot {
    display: flex;
    flex-direction: row;
    width: calc(var(--totalPages) * 100%);

    transition: all 300ms;
    & > :global(*) {
      width: 100%;
      height: 100%;
      flex: 1;
    }
  }

  .arrow-button {
    width: 8rem;
    height: 8rem;
    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  nav.controls.lg {
    font-size: 4rem;
  }
  nav.controls.md {
    font-size: 3rem;
    .arrow-button {
      width: 8rem;
    }
  }

  nav.controls.sm {
    font-size: 2rem;
    .arrow-button {
      width: 6rem;
    }
  }
</style>

<script define:vars={{ paginatorId, totalPages }} is:inline>
  const clamp = (num, min, max) => Math.min(Math.max(num, min), max);

  console.log("initializing paginator ", paginatorId);

  const currentPageElement = document.querySelector(
    `span[data-paginator="${paginatorId}-currentPage"]`,
  );

  const pageSlot = document.querySelector(
    `div[data-paginator="${paginatorId}-page-slot"]`,
  );
  const nextButton = document.querySelector(
    `button[data-paginator="${paginatorId}-next"]`,
  );
  const previousButton = document.querySelector(
    `button[data-paginator="${paginatorId}-previous"]`,
  );

  if (!currentPageElement) {
    throw new Error(`Could not find currentPage element for ${paginatorId}`);
  }

  function getCurrentPage() {
    return currentPageElement.dataset["page"];
  }

  function updatePageUI() {
    console.debug("updating page");

    pageSlot.style.transform = `translateX(calc(${-100 / totalPages}% * ${getCurrentPage() - 1}))`;
    if (getCurrentPage() == "1") {
      previousButton.style.opacity = "0.5";
      previousButton.disabled = true;
    } else {
      previousButton.style.opacity = "1";
      previousButton.disabled = false;
    }

    if (getCurrentPage() == `${totalPages}`) {
      nextButton.style.opacity = "0.5";
      nextButton.disabled = true;
    } else {
      nextButton.style.opacity = "1";
      nextButton.disabled = false;
    }
  }

  function setPage(num) {
    console.debug("setting page to ", num);
    currentPageElement.dataset["page"] = num;
    currentPageElement.innerHTML = `${getCurrentPage()}`;
    updatePageUI();
  }

  function nextPage() {
    setPage(clamp(parseInt(getCurrentPage()) + 1, 1, totalPages));
  }

  function previousPage() {
    setPage(clamp(parseInt(getCurrentPage()) - 1, 1, totalPages));
  }

  nextButton.addEventListener("click", () => {
    nextPage();
  });

  previousButton.addEventListener("click", () => {
    console.debug("going back");
    previousPage();
  });
</script>
