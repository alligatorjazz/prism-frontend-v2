---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import arrowImage from "@assets/img/arrow7.png";

export interface StickerProps {
  title: string;
  image: ImageMetadata;
  arrow?: "bottom-left" | "bottom-right" | "top-left" | "top-right" | "none";
  href: string;
}

type Props = StickerProps;
const { title, image, arrow, href } = Astro.props;
---

<a class:list={["container", arrow ?? "none"]} href={href}>
  <div class="sticker">
    <Image src={image} alt={title} class={"image"} />
  </div>
  <div class:list={["arrow"]}>
    <Image src={arrowImage} alt={""} class={"image"} />
  </div>
  <div class="label">
    <p>{title}</p>
  </div>
</a>

<style>
  a.container {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    --transition: all 300ms;
    transition: var(--transition);
    * {
      transition: var(--transition);
    }
    position: relative;

    .sticker {
      --size: 250px;
      width: var(--size);
      height: var(--size);

      filter: drop-shadow(1px 1px 0.5px var(--text-color));
      img {
        width: 100%;
        max-width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .arrow {
      width: 50%;
      position: absolute;
      img {
        width: 100%;
        max-width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .label {
      font-family: var(--handwriting);
      font-size: 2rem;
      text-align: center;
      p {
        margin: 0;
        color: var(--text-color);
      }
    }

    &:nth-child(even) {
      .sticker {
        rotate: 4deg;
      }
    }
    &:nth-child(odd) {
      .sticker {
        rotate: -3deg;
      }
    }

    &:hover {
      .sticker {
        rotate: 0deg;
        filter: drop-shadow(2px 2px 5px var(--text-color));
      }
    }

    /* orientations */
    &.bottom-right {
      .arrow {
        bottom: 0%;
        right: -35%;
        rotate: -10deg;
      }
    }

    &.bottom-left {
      .arrow {
        bottom: 0%;
        left: -35%;
        rotate: 10deg;
        transform: scaleX(-1);
      }
    }

    &.top-left {
      flex-direction: column-reverse;
      .arrow {
        top: 0%;
        left: -35%;
        transform: scaleX(-1) scaleY(-1);
      }
    }

    &.top-right {
      flex-direction: column-reverse;
      .arrow {
        top: 0%;
        right: -35%;
        transform: scaleY(-1);
      }
    }

    &.none {
      .arrow {
        display: none;
      }
    }
  }
</style>
