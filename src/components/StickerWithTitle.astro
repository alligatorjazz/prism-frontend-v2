---
import demo from "@assets/img/scale.avif";
import { Image } from "astro:assets";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<a class="container">
  <div class="sticker">
    <Image src={demo} alt="dummy" class={"image"} />
    <Image src={demo} alt="dummy" class={"outline"} />
  </div>
  <div class="label">
    <p>{title}</p>
  </div>
</a>

<style>
  a.container {
    .sticker {
      --size: 250px;
      width: var(--size);
      height: var(--size);
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        grid-row: 1;
        grid-column: 1;
      }

      .outline {
        filter: brightness(0) invert(1);
        transform: scale(1.025);
      }
      .image {
        z-index: 2;
      }
    }

    .label {
      font-family: var(--handwriting);
      font-size: 2rem;
      text-align: center;
    }

    &:nth-child(even) {
      .sticker {
        rotate: 4deg;
      }
    }
    &:nth-child(odd) {
      .sticker {
        rotate: -3deg;
      }
    }
  }
</style>
