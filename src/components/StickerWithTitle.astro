---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import arrow from "@assets/img/arrow7.png";

export interface StickerProps {
  title: string;
  image: ImageMetadata;
  outlineTransform?: string;
  href: string;
}

type Props = StickerProps;
const { title, image, outlineTransform, href } = Astro.props;
---

<a class="container" href={href}>
  <div class="sticker">
    <Image src={image} alt={title} class={"image"} />
  </div>
  <div class="arrow">
    <Image src={arrow} alt={""} class={"image"} />
  </div>
  <div class="label">
    <p>{title}</p>
  </div>
</a>

<style>
  a.container {
    display: block;
    text-decoration: none;
    --transition: all 300ms;
    transition: var(--transition);
    * {
      transition: var(--transition);
    }
    position: relative;

    .sticker {
      --size: 250px;
      width: var(--size);
      height: var(--size);

      filter: drop-shadow(1px 1px 0.5px var(--text-color));
      img {
        width: 100%;
        max-width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .arrow {
      width: 50%;
      position: absolute;
      & {
        bottom: 15%;
        right: -25%;
        rotate: 10deg;
      }
      img {
        width: 100%;
        max-width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .label {
      font-family: var(--handwriting);
      font-size: 2rem;
      text-align: center;
      p {
        color: var(--text-color);
      }
    }

    &:nth-child(even) {
      .sticker {
        rotate: 4deg;
      }
    }
    &:nth-child(odd) {
      .sticker {
        rotate: -3deg;
      }
    }

    &:hover {
      .sticker {
        rotate: 0deg;
        filter: drop-shadow(2px 2px 5px var(--text-color));
      }
    }
  }
</style>
