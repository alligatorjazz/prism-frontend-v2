---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}
const { class: className, ...props } = Astro.props;
---

<div class:list={["container", className]} {...props}>
  <div>
    <slot name="top" />
  </div>
  <div>
    <slot name="middle" />
  </div>
  <div>
    <slot name="bottom" />
  </div>
</div>

<style>
  .container {
    display: grid;
    grid-template-columns: 165px 165px 165px;
    grid-template-rows: 125px 125px 125px 125px;

    div:nth-child(1) {
      grid-column: 2 / 4;
      grid-row: 1 / 3;
      rotate: 5deg;
    }

    div:nth-child(2) {
      grid-column: 1 / 3;
      grid-row: 2 / 4;
      rotate: -6deg;
    }

    div:nth-child(3) {
      grid-column: 2 / 4;
      grid-row: 3 / 5;
    }

    div > img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }
</style>
