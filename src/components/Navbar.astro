---
import { Icon } from "astro-icon/components";
import type { Route, SiteMetadata } from "../types";
import NavLinks from "./NavLinks.astro";
import { Image } from "astro:assets";

export const prerender = false;
interface Props {
  siteMetadata: SiteMetadata;
  routes: Route[];
}

const { siteMetadata, routes } = Astro.props;
---

<header>
  <a href="/" class="site-logo">
    <!-- TODO: add logo support -->
    {
      siteMetadata.logo ? (
        <Image
          src={siteMetadata.logo}
          alt={`The ${siteMetadata.title} logo.`}
          width={247}
          height={71}
        />
      ) : (
        <p>siteMetadata.title</p>
      )
    }
  </a>
  <div class="desktop-nav">
    <div class="search">
      <Icon name="ri:search-line" />
      <input type="text" name="site-search" placeholder="Search..." value="" />
    </div>
    <nav role="navigation" class="links"><NavLinks routes={routes} /></nav>
  </div>
  <button id="trigger"><Icon name={"ri:menu-fill"} /> </button>
  <div class="mobile-nav">
    <div class="content">
      <div class="search">
        <Icon name="ri:search-line" size={32} />
        <input
          type="text"
          name="site-search"
          placeholder="Search..."
          value=""
        />
      </div>
      <nav role="navigation">
        <NavLinks class={"links"} routes={routes} />
      </nav>
    </div>
  </div>
</header>

<style lang="scss">
  @use "../styles/utils" as *;

  body[data-prev-scroll="down"] header {
    height: 0;
    overflow: hidden;
  }

  header {
    width: 100%;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    position: fixed;
    top: 0;
    left: 0;
    background-color: var(--bg-color);
    height: 10rem;
    transition: height 300ms;
    filter: var(--shadow);
    z-index: 100;

    a.site-logo {
      width: 12rem;
      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .mobile-nav {
      /* hides on desktop */
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: fixed;
      top: 0;
      right: 0;
      min-height: 100vh;
      min-width: 100vw;
      pointer-events: none;
      transition: all 300ms;

      @include breakpoint-up(md) {
        display: none;
      }

      .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
        justify-content: center;
        padding: 1rem;
        transform: translateX(100%);
        transition: all 300ms;
        background: red;
        nav > :global(ul) {
          display: flex;
          align-items: end;
          flex-direction: column;
        }
      }
    }

    button#trigger {
      /* hides on desktop */
      display: block;
      @include breakpoint-up(md) {
        display: none;
      }
    }

    div.desktop-nav {
      /* hides on mobile */
      display: none;
      @include breakpoint-up(md) {
        display: flex;
      }
      flex-direction: column;
      /* gap: 1.5rem; */
      font-size: 1.25rem;

      & > .search {
      }
    }

    .search {
      width: 100%;
      padding: 0.5rem;
      background-color: var(--fg-color);
      border-radius: var(--round-edge);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      & > svg {
      }

      & > input {
        border: 0;
        flex: 1;
        font-family: var(--header-font);
        font-weight: bold;
      }
    }
  }

  body[data-drawer="active"] header {
    .mobile-nav {
      backdrop-filter: blur(4px);
      background: magenta;
      pointer-events: initial;
      .content {
        transform: translateX(0);
      }
    }
  }
</style>
<script>
  import { checkBreakpoint } from "../lib/";
  function updateDrawerState(e?: PointerEvent) {
    // console.log((e?.target as HTMLElement).tagName);
    if ((e?.target as HTMLElement).tagName.toLowerCase() === "a") {
      // prevents drawer retraction before navlink is clicked
      return;
    }

    const header = document.querySelector("header");
    const prevDrawerState = document.body.dataset["drawer"];

    if (!header) {
      throw new Error("Couldn't update nav - header does not exist");
    }

    // set mobile expanded drawer
    if (checkBreakpoint("md")) {
      document.body.dataset["drawer"] = "inactive";
    } else {
      if (prevDrawerState === "inactive") {
        document.body.dataset["drawer"] = "active";
      } else {
        document.body.dataset["drawer"] = "inactive";
      }
    }
  }

  const trigger = document.getElementById("trigger");
  const mobileNav = document.querySelector<HTMLDivElement>("nav.mobile-nav");
  trigger?.addEventListener("pointerdown", updateDrawerState);
  mobileNav?.addEventListener("pointerdown", updateDrawerState);

  window.addEventListener("resize", () => {
    if (checkBreakpoint("md")) {
      updateDrawerState();
    }
  });

  let lastScrollPosition = window.scrollY;
  function updatePrevScroll() {
    const header = document.querySelector("header");
    if (!header) {
      throw new Error("Couldn't find the header element.");
    }
    const newScrollPosition = window.scrollY;
    document.body.dataset["prevScroll"] =
      lastScrollPosition > newScrollPosition || window.scrollY < 250
        ? "up"
        : "down";
    lastScrollPosition = newScrollPosition;
  }

  window.addEventListener("scroll", updatePrevScroll);
</script>
