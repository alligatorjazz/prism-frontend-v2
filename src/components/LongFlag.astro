<div class="long-flag" role="none">
  <div class="color-stripes">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
  <div class="white-stripe"></div>
</div>

<style>
  .long-flag {
    --stripe-width: 3rem;
    width: 100%;
    display: flex;
    height: calc(var(--stripe-width) * 6);

    .color-stripes {
      flex: 1;
      div {
        height: var(--stripe-width);
        width: 100%;
      }

      div:nth-child(1) {
        background: var(--rainbow-red);
      }

      div:nth-child(2) {
        background: var(--rainbow-orange);
      }

      div:nth-child(3) {
        background: var(--rainbow-yellow);
      }

      div:nth-child(4) {
        background: var(--rainbow-green);
      }

      div:nth-child(5) {
        background: var(--rainbow-blue);
      }

      div:nth-child(6) {
        background: var(--rainbow-purple);
      }
    }
    .white-stripe {
      width: calc(var(--stripe-width) / 2);
      height: 100%;
      background-color: white;
    }
  }
</style>
