---
interface Props {
  name: string;
  price: string;
  frequency: string;
  benefits: string[];
  highlighted?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  name,
  price,
  frequency,
  benefits,
  highlighted = false,
  ctaHref,
  ctaLabel = "Select",
} = Astro.props;
---

<article class:list={["tier-card", { highlighted }]}>
  <div class="header">
    <h3>{name}</h3>
    <p class="price">
      <span class="amount">{price}</span>
      <span class="frequency">/{frequency}</span>
    </p>
  </div>

  <ul class="benefits">
    {benefits.map((benefit) => <li>{benefit}</li>)}
  </ul>

  {
    ctaHref && (
      <a href={ctaHref} class="cta" target="_blank" rel="noopener noreferrer">
        {ctaLabel}
      </a>
    )
  }
</article>

<style lang="scss">
  .tier-card {
    flex: 1;
    &:last-of-type {
      min-width: 50%;
    }
    background: var(--fg-color);
    border: 2px solid var(--text-color);
    border-radius: var(--round-edge);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 5px 5px 0 var(--text-color);
    }

    &.highlighted {
      border-color: var(--accent-color);
      background: linear-gradient(
        var(--youth-yellow-2),
        var(--youth-yellow-1) 10%
      );
    }

    .header {
      text-align: center;
      border-bottom: 2px solid var(--text-color);
      padding-bottom: 1rem;

      h3 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
      }

      .price {
        margin: 0;

        .amount {
          font-size: 2rem;
          font-weight: bold;
          font-family: var(--header-font);
        }

        .frequency {
          font-size: 1rem;
          color: var(--text-muted);
        }
      }
    }

    .benefits {
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;

      li {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 0.75rem;
        font-size: 1rem;
        line-height: 1.4;

        &::before {
          content: "✓";
          position: absolute;
          left: 0;
          color: var(--accent-color);
          font-weight: bold;
        }
      }
    }

    .cta {
      background-color: var(--accent-color);
      color: var(--fg-color);
      padding: 0.75rem 1rem;
      border-radius: var(--round-edge);
      text-align: center;
      text-decoration: none;
      font-weight: bold;
      transition: filter 0.2s ease;

      &:hover {
        filter: brightness(110%);
      }
    }
  }
</style>
