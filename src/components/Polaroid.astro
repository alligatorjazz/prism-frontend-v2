---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
interface Props extends HTMLAttributes<"div"> {
  image: ImageMetadata & { alt: string };
  label?: string;
}
const { class: className, image, label, ...props } = Astro.props;
---

<div class:list={["container", className]} {...props}>
  <Image {...image} />
  <p class="label">
    {label}
  </p>
</div>

<style>
  .container {
    --font-size: 1.25rem;
    --border-size: 12px;
    border: var(--border-size) solid var(--fg-color);
    background-color: var(--fg-color);
  }

  img {
    width: 100%;
    height: calc(100% - var(--font-size) - (var(--border-size) * 2));
    object-fit: cover;
  }

  .label {
    margin: 0;
    padding: var(--border-size);
    background-color: var(--fg-color);
    text-align: center;
    font-weight: bold;
    font-size: var(--font-size);
    font-style: var(--header-font);
    white-space: nowrap;
    width: 100%;
  }
</style>
