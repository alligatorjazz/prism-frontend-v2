---
import SectionBorder from "./SectionBorder.astro";

interface Props {
  background?: string;
  borderTop?: boolean;
  borderBottom?: boolean;
}
const { background, borderTop, borderBottom } = Astro.props;
---

{
  borderTop ? (
    <SectionBorder
      flip
      type="spray-paint"
      backgroundColor="rgb(83, 193, 168)"
    />
  ) : (
    ""
  )
}
<div class="colored-header">
  <slot />
</div>
{
  borderBottom ? (
    <SectionBorder type="spray-paint" backgroundColor="rgb(83, 193, 168)" />
  ) : (
    ""
  )
}

<style define:vars={{ background }}>
  .colored-header {
    padding: 0 2rem;
    background: var(--background);
    h1 {
      margin: 0;
      text-align: center;
      font-size: 3rem;

      @include breakpoint-up(md) {
        font-size: 5rem;
      }
    }
  }
</style>
