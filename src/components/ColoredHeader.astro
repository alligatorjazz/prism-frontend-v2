---
import SectionBorder from "./SectionBorder.astro";

interface Props {
  background?: string;
  borderTop?: "spray-paint" | "marker";
  borderBottom?: "spray-paint" | "marker";
}
const { background, borderTop, borderBottom } = Astro.props;
---

{
  borderTop ? (
    <SectionBorder flip type={borderTop} backgroundColor="activist-aqua" />
  ) : (
    ""
  )
}
<div class="colored-header">
  <slot />
</div>
{
  borderBottom ? (
    <SectionBorder type={borderBottom} backgroundColor="activist-aqua" />
  ) : (
    ""
  )
}

<style define:vars={{ background }}>
  .colored-header {
    padding: 0 2rem;
    background: var(--background);
    h1 {
      margin: 0;
      text-align: center;
      font-size: 3rem;
      color: var(--fg-color);

      @include breakpoint-up(md) {
        font-size: 5rem;
      }
    }
  }
</style>
