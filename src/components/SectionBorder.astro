---
import { getImage } from "astro:assets";
import waveLeft from "@assets/img/borders/wave-left.svg";
import waveRight from "@assets/img/borders/wave-right.svg";

interface Props {
  type: "spray-paint" | "wave-left" | "wave-right" | "marker";
  backgroundColor:
    | "activist-aqua"
    | "youth-yellow-1"
    | "youth-yellow-2"
    | "youth-yellow-3"
    | "rainbow-red"
    | "rainbow-orange"
    | "rainbow-yellow"
    | "rainbow-green"
    | "rainbow-blue"
    | "rainbow-purple"
    | "bold-black"
    | "witty-white";

  flip?: boolean;
}

const { type, backgroundColor, flip } = Astro.props;
const imageBorders = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img/borders/*.{png,svg}",
);
const selectedBorderPath = Object.keys(imageBorders).find((key) =>
  key.includes(`${type}-${backgroundColor}`),
);
if (!selectedBorderPath && type !== "wave-left" && type !== "wave-right") {
  throw new Error(
    "Could not find selected border for " + `${type}-${backgroundColor}`,
  );
}
const selectedBorderObject =
  type === "wave-right" || type === "wave-left"
    ? null
    : await imageBorders[selectedBorderPath ?? ""]();
const selectedBorder = selectedBorderObject
  ? await getImage({ src: selectedBorderObject.default })
  : null;
const mask = `url("${type === "wave-left" ? waveLeft.src : waveRight.src}")`;
const bg =
  type === "wave-right" || type === "wave-left"
    ? `var(--${backgroundColor})`
    : undefined;
---

<div class:list={["container", flip ? "flipped" : ""]}>
  <div
    class:list={["border", type]}
    style={{
      backgroundImage:
        type === "spray-paint" || type === "marker"
          ? `url(${selectedBorder?.src})`
          : undefined,
    }}
  >
  </div>
</div>

<style define:vars={{ mask, bg }}>
  .container {
    position: relative;
    height: 0;
    &:not(.flipped) {
      .border {
        /* top: 2.2rem; */
      }
    }
  }

  .container.flipped {
    .border {
      bottom: 2rem;
      transform: scaleY(-1);
    }

    .border.wave-left,
    .border.wave-right {
      bottom: 7rem;
    }

    .border.marker {
      transform: scaleY(-1) scaleX(-1);
    }
  }

  .border {
    width: 100%;
    height: 4rem;
    z-index: 2;
  }

  .border.spray-paint {
    height: 2rem;
    position: relative;
    background-repeat: repeat-x;
    background-size: contain;
  }

  .border.marker {
    height: 3rem;
    position: relative;
    background-repeat: repeat-x;
    background-size: cover;
  }

  .border.wave-left,
  .border.wave-right {
    position: relative;
    background-color: var(--bg);
    mask: var(--mask);
    mask-size: 100% auto;
    mask-repeat: no-repeat;
    height: 7rem;
  }

  /* .border.cookie-cutter { */
  /*   position: relative; */
  /*   mask: conic-gradient( */
  /*       from -45deg at bottom, */
  /*       #0000, */
  /*       #000 1deg 89deg, */
  /*       #0000 90deg */
  /*     ) */
  /*     20%/2rem 100%; */
  /* } */

  /* .border.squiggle { */
  /*   position: relative; */
  /*   mask: */
  /*     radial-gradient(16px at 75% 100%, #0000 98%, #000) 50% calc(100% - 16px) / */
  /*       64px 100% repeat-x, */
  /*     radial-gradient(16px at 25% 50%, #000 99%, #0000 101%) bottom/64px 32px */
  /*       repeat-x; */
  /* } */
</style>
