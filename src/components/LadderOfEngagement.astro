---
// src/components/LadderOfEngagement.astro
// Based on: Membership Model - Section 1: Leadership Pipeline (Ladder of Engagement)

// const backgroundImage = `url(${ruledBg.src})`;
---

<div class="ladder-of-engagement">
  <h2>Get Involved With Prism!</h2>
  <p class="intro">
    Here's how you can join the next generation of LGBTQ+ storytellers,
    advocates, and changemakers in South Florida.
  </p>

  <style lang="scss">
    .ladder-of-engagement {
      padding: 3rem 2rem;
      background: var(--youth-yellow-2);

      h2 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 1rem;
        font-family: var(--handwriting);
      }

      .intro {
        font-weight: bold;
        font-family: var(--header-font);
        font-size: 1.25rem;
        text-align: center;
        max-width: 1200px;
        margin: 0 auto 3rem auto;
      }
    }
  </style>
</div>
