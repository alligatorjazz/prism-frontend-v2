{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@sections/*": [
        "./src/sections/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@templates/*": [
        "./src/templates/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@api/*": [
        "./src/api/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ]
}
